# 127.0.0.1 rather than localhost, deliberately. `localhost` resolves to
# ::1 first on Windows, and a leftover WSL relay can hold IPv6 loopback
# for a published Docker port — accepting the connection and then
# resetting it. Because the connect succeeds before the reset, Node's
# IPv4 fallback never fires, so the client retries forever and every
# cached lookup waits out its timeout. Naming the address skips the
# ambiguity entirely; nothing is lost, since both containers publish on
# IPv4.
DATABASE_URL=postgresql://cis:cis_dev_password@127.0.0.1:5432/utility_cis
REDIS_URL=redis://127.0.0.1:6379
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
API_URL=http://localhost:3001
# The premise map's tile token. It must be NEXT_PUBLIC_ — the component
# reading it (components/premises/map-view.tsx) runs in the browser, and
# Next.js exposes nothing else there. This line said MAPBOX_TOKEN until
# 2026-10-21, which Next.js silently drops, so following this file gave
# you the map's "token not set" panel and no map.
# This is the one vendor credential that legitimately lives here rather
# than in apptor-connect: a tile token is public by design, restricted
# by HTTP referrer at Mapbox, and has to reach the browser, so no
# server-side proxy can hold it. Server-side vendor credentials do not
# belong in this file — see CLAUDE.md § Integrations.
NEXT_PUBLIC_MAPBOX_TOKEN=

# apptor-connect — where stored bill PDFs are written and read.
# Both of these have defaults that point at nothing: left unset, the API
# boots and every bill download fails at the first capability-link call.
# Set them in any environment that produces bills. Which object store a
# given tenant's bills land in is per-tenant configuration
# (settings.billDocuments.storageIntegration), not env.
APPTOR_CONNECT_URL=http://localhost:8080
APPTOR_CONNECT_API_KEY=

# A capability link is a bearer credential, so its life is short. 30–900s.
BILL_DOCUMENT_LINK_TTL_SECONDS=300
# Upload ceiling for one bill PDF. Default 10 MiB.
BILL_DOCUMENT_MAX_BYTES=10485760
