/// Slice 4 task 4 — generic per-tenant key/value setting backing the
/// TenantLoader. Holds drought_stage, flag toggles (flags.<name>), and
/// any other tenant-scoped scalar/JSON value the rate engine needs to
/// resolve at evaluation time. Distinct from UtilityConfig (a single
/// row of well-known scheduler/runtime fields) — this is an open-ended
/// (utility_id, name) → JSON map.
/// A named tenant-level value that configuration references.
///
/// **What distinguishes it from `UtilityConfig` is who names the key.**
/// `UtilityConfig` holds settings code reads by name; here the names
/// come from outside this repository. Nothing declares
/// `flags.summer_surcharge` — a configurator invented it writing a rate
/// component.
///
/// Called `utility_setting` until 2026-10-31, where "setting" read as a
/// synonym of "config" and carried none of that. Briefly called
/// `rate_variable`, which was worse: it named the table after its only
/// current consumer, and `drought_stage` is an operating fact about the
/// utility — a city declares a drought stage — that rate components
/// happen to consume. A bill message or a portal banner could read it
/// tomorrow without becoming a rate.
///
/// The rate engine is how it is read today: a component can reference
/// `drought_stage` or
/// `flags.<anything>`, `manifest()` collects every variable key the
/// active components mention, and `TenantLoader` fetches those names
/// here. Nothing in this repository names `flags.summer_surcharge` — a
/// configurator invented it writing a rate component.
///
/// So it has, and should keep, **no declaration of valid keys**: a list
/// would defeat the mechanism. That is the opposite of
/// `SchedulerConfig`, whose keys are code and whose values are
/// configuration.
///
/// And it stays its own table rather than moving into
/// `UtilityConfig.settings` for a measured reason: four of the eight
/// readers of that row fetch it whole, three of them per bill or per
/// notification, so an unbounded set of flags there would be dragged
/// through every bill a run produces. Writing one key would also become
/// `jsonb_set` (which Prisma cannot express) or a read-modify-write that
/// loses concurrent updates, and `updated_at` per key would collapse
/// into one timestamp for the whole row.
///
/// The old name had already sent two designs the wrong way — the AR
/// ledger's fee-ranking order was earmarked for it, and the
/// architecture doc filed it among the tenant-config satellites. A
/// code-known tenant setting belongs in `UtilityConfig` or its
/// `settings` jsonb; see spec 18 "Where a tenant setting goes".
///
/// A missing row is the zero case, deliberately: `drought_stage` absent
/// reads as 0 ("no drought declared") and a missing flag as false, so a
/// configurator can reference a variable before anyone has set it
/// without breaking a rating run.
model UtilityVariable {
  id        String   @id @default(uuid()) @db.Uuid
  utilityId String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  /// Namespaced by convention — `drought_stage`, `flags.<name>`.
  name      String   @map("name") @db.VarChar(100)
  value     Json     @map("value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, name])
  @@index([utilityId])
  @@map("utility_variable")
}

/// Slice 4 task 5 — Winter Quarter Average (WQA) value backing the
/// WqaLoader. One row per (utility_id, service_agreement_id, water_year)
/// stores both the seasonally-computed average and an optional staff
/// override. The Bozeman sewer Residential/Multi-Family classes use
/// this via the `wqa:current:<sa_id>` and `wqa:override:<sa_id>`
/// variable patterns; override wins over computed_avg when both are
/// set, otherwise computed_avg is returned.
model WqaValue {
  id                  String    @id @default(uuid()) @db.Uuid
  utilityId           String    @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  serviceAgreementId  String    @map("service_agreement_id") @db.Uuid
  waterYear           Int       @map("water_year")
  computedAt          DateTime  @map("computed_at") @db.Timestamptz
  sourceWindowStart   DateTime  @map("source_window_start") @db.Date
  sourceWindowEnd     DateTime  @map("source_window_end") @db.Date
  computedAvg         Decimal   @map("computed_avg") @db.Decimal(10, 4)
  overrideValue       Decimal?  @map("override_value") @db.Decimal(10, 4)
  overrideReason      String?   @map("override_reason") @db.Text
  overrideBy          String?   @map("override_by") @db.Uuid
  overrideAt          DateTime? @map("override_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  serviceAgreement    ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  @@unique([utilityId, serviceAgreementId, waterYear])
  @@index([utilityId, serviceAgreementId])
  @@map("wqa_value")
}

enum LedgerEntryType {
  BILL_CHARGE
  FEE
  ADJUSTMENT_DEBIT
  PAYMENT
  ADJUSTMENT_CREDIT
  WRITE_OFF
  REVERSAL
  /// Money the utility HOLDS for the customer, not money the customer
  /// owes. A credit, like a payment, but deliberately not one: a deposit
  /// is excluded from allocation (the next bill must not spend it) and
  /// from `Account.balance` (a customer owing $169 while the utility
  /// holds their $500 is still $169 in arrears, and the delinquency
  /// sweep must still see them). `Account.depositAmount` caches the sum
  /// of the open ones.
  DEPOSIT
  /// Money given back: an overpayment returned, or a deposit released.
  /// A DEBIT, positive like a charge, because it discharges a credit the
  /// customer already held rather than granting them a new one. Carries
  /// `tender`, `externalRef` and `effectiveDate` as its disbursement
  /// record — how the money left, the cheque number, the day it issued.
  /// Says which pool it drew from by which credits it consumes, since a
  /// deposit must never be spent by an act that did not ask for one.
  REFUND
}

enum PaymentTender {
  CARD
  ACH
  CASH
  CHECK
  LOCKBOX
}

/// One financial event against an account. Signed: positive increases
/// what the customer owes the utility, negative reduces it. `amount`,
/// `type`, `dueDate` and `effectiveDate` are immutable once written;
/// `openAmount` is maintained bookkeeping, like Account.balance.
///
/// Provenance columns differ in how hard they are held, and all of it is
/// enforced in SQL rather than by service discipline:
///   - a BILL_CHARGE names a bill;
///   - only a PAYMENT carries a tender;
///   - FEE / ADJUSTMENT_DEBIT / ADJUSTMENT_CREDIT / WRITE_OFF cite a
///     `reasonId`, OR name the bill they came from — the second clause
///     exists for the credit a negative bill posts, which is
///     self-explaining and must not depend on a tenant having reason
///     seeds (`ledger_entry_reason_required`);
///   - only a FEE may carry `assessedOnId`. It is NOT required on a fee:
///     a tap fee or meter test fee is assessed on nothing
///     (`ledger_entry_assessed_on_only_fee`).
model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  utilityId     String          @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  accountId     String          @map("account_id") @db.Uuid
  type          LedgerEntryType @map("type")
  amount        Decimal         @map("amount") @db.Decimal(14, 2)
  openAmount    Decimal         @map("open_amount") @db.Decimal(14, 2)
  dueDate       DateTime?       @map("due_date") @db.Date
  effectiveDate DateTime        @map("effective_date") @db.Date
  postedAt      DateTime        @default(now()) @map("posted_at") @db.Timestamptz
  reasonId      String?         @map("reason_id") @db.Uuid
  billId        String?         @map("bill_id") @db.Uuid
  assessedOnId  String?         @map("assessed_on_id") @db.Uuid
  reversesId    String?         @map("reverses_id") @db.Uuid
  tender        PaymentTender?  @map("tender")
  externalRef   String?         @map("external_ref") @db.VarChar(100)
  memo          String?         @map("memo") @db.Text
  createdBy     String?         @map("created_by") @db.Uuid

  account      Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reason       LedgerReasonDef?    @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  bill         Bill?               @relation(fields: [billId], references: [id], onDelete: Restrict)
  assessedOn   LedgerEntry?        @relation("LedgerFeeSource", fields: [assessedOnId], references: [id], onDelete: Restrict)
  assessedFees LedgerEntry[]       @relation("LedgerFeeSource")
  reverses     LedgerEntry?        @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy   LedgerEntry[]       @relation("LedgerReversal")
  creditsOut   LedgerApplication[] @relation("LedgerAppCredit")
  debitsIn     LedgerApplication[] @relation("LedgerAppDebit")

  @@index([utilityId, accountId, postedAt(sort: Desc)])
  @@index([utilityId, billId])
  @@index([assessedOnId])
  @@index([reversesId])
  @@map("ledger_entry")
}

/// Which credit paid down which debit, and by how much. `amount` is
/// always positive; the parents' signs make it subtract from a debit
/// and add to a credit, both converging on zero.
///
/// The table ships empty in slice 1: nothing writes or seeds it. Rows
/// arrive in slice 2, when payment allocation lands.
model LedgerApplication {
  id        String   @id @default(uuid()) @db.Uuid
  utilityId String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  creditId  String   @map("credit_id") @db.Uuid
  debitId   String   @map("debit_id") @db.Uuid
  amount    Decimal  @map("amount") @db.Decimal(14, 2)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz

  credit LedgerEntry @relation("LedgerAppCredit", fields: [creditId], references: [id], onDelete: Restrict)
  debit  LedgerEntry @relation("LedgerAppDebit", fields: [debitId], references: [id], onDelete: Restrict)

  @@index([creditId])
  @@index([debitId])
  @@map("ledger_application")
}

/// Why a fee or adjustment was raised, in the utility's own words.
/// Tenant-configurable, following the *TypeDef convention.
///
/// The table ships empty in slice 1: nothing writes it and the seeder
/// does not populate it. The reason codes are seeded in slice 3,
/// alongside the fees that reference them.
model LedgerReasonDef {
  id            String          @id @default(uuid()) @db.Uuid
  utilityId     String          @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code          String          @map("code") @db.VarChar(50)
  label         String          @map("label") @db.VarChar(255)
  appliesToType LedgerEntryType @map("applies_to_type")
  isActive      Boolean         @default(true) @map("is_active")
  /// Whether an entry citing this reason is itself a penalty, rather
  /// than money owed for something. A percentage late fee is charged on
  /// principal, so it must exclude an earlier late fee from its base but
  /// not an unpaid tap fee — and nothing else on the entry can tell
  /// those apart: both are type FEE, and the code cannot be asked,
  /// because reasons are tenant-configurable.
  isPenalty     Boolean         @default(false) @map("is_penalty")
  /// Whether a delinquency tier may book its late fee to this reason.
  ///
  /// Only a late-fee reason should. A returned-payment fee is raised
  /// when a payment bounces, a tap fee when a tap is cut, a meter test
  /// fee when a meter is tested, a reconnection fee when service is
  /// restored — each answers to its own event, and none of them is
  /// "time passed". Offering every FEE reason left a tier's dropdown
  /// with one right answer out of five.
  ///
  /// It lives here rather than as a list of codes inside the
  /// delinquency module for the same reason `isPenalty` does: reason
  /// codes are tenant-configurable, so a utility that calls theirs
  /// RETURNED_ITEM would defeat any such list.
  allowsDelinquencyFee Boolean   @default(false) @map("allows_delinquency_fee")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  entries LedgerEntry[]

  @@unique([utilityId, code])
  @@index([utilityId, appliesToType])
  @@map("ledger_reason_def")
}

/// Configurable text printed on bills (Bozeman #137). Targeting is by
/// account type and/or commodity; null on either side means "all".
/// Selection happens at the bill's own bill_date, never at now(), so a
/// reprint reproduces the messages the bill originally carried.
model BillMessage {
  id               String    @id @default(uuid()) @db.Uuid
  utilityId        String    @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  label            String    @map("label") @db.VarChar(255)
  body             String    @map("body") @db.Text
  accountTypeDefId String?   @map("account_type_def_id") @db.Uuid
  commodityId      String?   @map("commodity_id") @db.Uuid
  priority         Int       @default(100) @map("priority")
  activeFrom       DateTime  @map("active_from") @db.Date
  activeTo         DateTime? @map("active_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  accountTypeDef AccountTypeDef? @relation(fields: [accountTypeDefId], references: [id], onDelete: Restrict)
  commodity      Commodity?      @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@index([utilityId, activeFrom])
  @@map("bill_message")
}

/// The generated artifact for one bill. Holds a pointer, never bytes: the
/// object lives in the tenant's own store (S3, Azure Blob or GCS),
/// reached through apptor-connect's files plane, which also holds the
/// credential. No URL is stored — a capability link is minted per
/// access and discarded.
///
/// One row per bill per document type. Generating again replaces it in
/// place; there is deliberately no version column, because nothing yet
/// produces a second version whose content differs and nothing delivers
/// a bill, so there is no sent copy to preserve.
model BillDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  utilityId          String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  billId             String   @map("bill_id") @db.Uuid
  /// `PDF` today. VARCHAR rather than an enum because PRINT_EXPORT and
  /// EMAIL_HTML are not designed yet and Postgres cannot remove an enum
  /// value once added.
  documentType       String   @map("document_type") @db.VarChar(20)
  storageIntegration String   @map("storage_integration") @db.VarChar(100)
  storageConnection  String?  @map("storage_connection") @db.VarChar(100)
  objectKey          String   @map("object_key") @db.VarChar(500)
  /// Null until the upload completes. A row exists first so the unique
  /// constraint decides which concurrent render proceeds; a row with no
  /// size and no hash means "claimed, not yet stored".
  byteSize           Int?     @map("byte_size")
  sha256             String?  @map("sha256") @db.Char(64)
  templateKey        String   @map("template_key") @db.VarChar(100)
  generatedAt        DateTime @default(now()) @map("generated_at") @db.Timestamptz
  isPaperless        Boolean  @map("is_paperless")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([billId, documentType])
  @@index([utilityId, generatedAt])
  @@map("bill_document")
}

/// One initiated billing run over one cycle's window.
///
/// A row rather than a long request: twelve thousand accounts each
/// rating several agreements is minutes of work, and an HTTP request
/// that long dies to a proxy with the work half done and no record of
/// how far it got — while re-running it turns the per-account overlap
/// guard into twelve thousand 409s instead of a resume. What makes a run
/// usable is the record of what happened to each account.
///
/// Shaped after ImportBatch deliberately, not factored out of it: the
/// two share a shape, not a schema, and a generic batch-runner serving
/// two consumers with different fields and different failure
/// vocabularies would buy indirection and cost clarity.
model BillingRun {
  id             String           @id @default(uuid()) @db.Uuid
  utilityId      String           @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  billingCycleId String           @map("billing_cycle_id") @db.Uuid
  /// The scheduling window — which accounts are due and which reads to
  /// expect. NOT the service period: that is read to read and per
  /// account, and lives on the segments and the bill.
  windowStart    DateTime         @map("window_start") @db.Date
  windowEnd      DateTime         @map("window_end") @db.Date
  /// The utility's own dates, identical across the run, so the run is
  /// something a CSR can talk about ("the October run"). Passed in
  /// rather than derived per account, so one bad clock cannot split a
  /// run across two days.
  billDate       DateTime         @map("bill_date") @db.Date
  dueDate        DateTime         @map("due_date") @db.Date
  status         BillingRunStatus @default(PENDING) @map("status")
  accountCount   Int              @default(0) @map("account_count")
  billedCount    Int              @default(0) @map("billed_count")
  /// Counted apart because only one of them is work. One
  /// `exception_count` added "nothing to bill" to "should have billed
  /// and could not", so a run with forty skips and no failures read as
  /// forty things to fix. Their sum is still available, derived.
  failedCount    Int              @default(0) @map("failed_count")
  skippedCount   Int              @default(0) @map("skipped_count")
  /// Posting is a second act over the run. A run is exactly when a bad
  /// rate change becomes twelve thousand wrong charges, and reversing
  /// those is a far worse afternoon than discarding unposted bills.
  postedAt       DateTime?        @map("posted_at") @db.Timestamptz
  postedBy       String?          @map("posted_by") @db.Uuid
  /// When the current posting pass began, and the only way to tell that
  /// one is under way: `postedAt` is stamped after the loop, so it
  /// cannot mark the middle. A pass that died leaves this set with
  /// `postedAt` still null, which is what the boot sweep reclaims —
  /// the posting equivalent of generation's `status = RUNNING`.
  /// The sweep's partial index over this pair exists in SQL only.
  postingStartedAt DateTime?      @map("posting_started_at") @db.Timestamptz
  cancelRequested Boolean         @default(false) @map("cancel_requested")
  lastProgressAt DateTime?        @map("last_progress_at") @db.Timestamptz
  /// Null means the schedule started this run, not a person.
  ///
  /// A scheduled run has no user principal. The audit trail carries the
  /// sentence instead — `actorName` of "Billing dispatcher" and a
  /// `source` of `scheduler:billing-dispatch` — which is the convention
  /// the suspension sweep already writes. The alternative, a reserved
  /// system uuid, would need a `cis_user` row that is not a user and
  /// belongs to no tenant.
  ///
  /// The boot sweep resumes a run as `createdBy`, so it reads this too:
  /// a reclaimed scheduled run stays scheduled rather than acquiring an
  /// author.
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  cycle BillingCycle     @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)
  items BillingRunItem[]

  /// One run per cycle per window. A second attempt is a 409 naming the
  /// first, not a second set of bills.
  @@unique([utilityId, billingCycleId, windowEnd])
  @@index([utilityId, createdAt])
  @@map("billing_run")
}

/// One account's outcome in a run.
///
/// The exception list is the whole value of a run, so an item carries
/// why as well as what: the code and message the service threw, and the
/// service period actually billed, so a 44-day interval is visible
/// without opening the bill.
model BillingRunItem {
  id                 String               @id @default(uuid()) @db.Uuid
  utilityId          String               @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  billingRunId       String               @map("billing_run_id") @db.Uuid
  accountId          String               @map("account_id") @db.Uuid
  status             BillingRunItemStatus @default(PENDING) @map("status")
  billId             String?              @map("bill_id") @db.Uuid
  servicePeriodStart DateTime?            @map("service_period_start") @db.Date
  servicePeriodEnd   DateTime?            @map("service_period_end") @db.Date
  segmentCount       Int                  @default(0) @map("segment_count")
  /// A snapshot, like LedgerEntry.amount: the run's own page shows money
  /// without joining every bill.
  total              Decimal?             @map("total") @db.Decimal(14, 4)
  errorCode          String?              @map("error_code") @db.VarChar(64)
  errorMessage       String?              @map("error_message") @db.Text
  processedAt        DateTime?            @map("processed_at") @db.Timestamptz

  run     BillingRun @relation(fields: [billingRunId], references: [id], onDelete: Cascade)
  account Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bill    Bill?      @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@unique([billingRunId, accountId])
  @@index([billingRunId, status])
  @@map("billing_run_item")
}

/// A dated remark a staff member attaches to a record.
///
/// Polymorphic on (entityType, entityId) like `Attachment`, so one
/// table serves every entity. The body is **never edited** — a note
/// records that somebody observed something at a time, and an editable
/// note records nothing in particular, so there is no `updatedAt`. It
/// can be **withdrawn**, which is the one state change it has, and that
/// is soft: `deletedAt`/`deletedBy` rather than a DELETE, because
/// "was there ever a note here" is the question a dispute asks.
///
/// `authorName` is copied, not joined: a note outlives the staff member
/// who wrote it, and "who said this" has to survive their row being
/// deactivated or purged.
///
/// Writable in both operating modes. Spec 28's OVL-T-3 is what forced
/// it — a mirrored record is read-only, and a read-only record with
/// nowhere to note "the customer says this is wrong" just moves the
/// note onto paper — but recording a conversation is not an overlay
/// concern.
model Note {
  id          String   @id @default(uuid()) @db.Uuid
  utilityId   String   @map("utility_id") @db.Uuid
  utility     Utility  @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  body        String   @db.Text
  authorId    String   @map("author_id") @db.Uuid
  authorName  String   @map("author_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Withdrawn, not erased. Soft because the table's purpose is to be a
  /// record of what somebody said at a time — erasing the row would make
  /// "was there ever a note here" unanswerable, which is the question a
  /// dispute asks. Set together with `deletedBy`, which a CHECK enforces.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid

  /// Partial on the live rows — the common read is a record's notes,
  /// newest first, and Postgres cannot use a plain index to skip
  /// withdrawn ones. Prisma cannot express the predicate, so the real
  /// index is in the `note_soft_delete` migration and this declaration
  /// exists only so `migrate dev` is not tempted to add a second.
  @@index([utilityId, entityType, entityId, createdAt(sort: Desc)], map: "note_subject_idx")
  @@index([utilityId, authorId, createdAt(sort: Desc)], map: "note_author_idx")
  @@map("note")
}

/// A tenant's seasons, effective-dated and published like a rate
/// schedule — changing when summer starts changes what a bill costs, so
/// it is a new version with a date, never an edit to the one that
/// billed (spec 26, TOU-SEA-2).
///
/// Replaces the hard-coded `seasonOf()`, which returned summer for
/// May–October for every tenant. Every existing tenant was seeded with
/// that behaviour by the `season_sets` migration, so no tariff changed
/// meaning.
model SeasonSet {
  id            String    @id @default(uuid()) @db.Uuid
  utilityId     String    @map("utility_id") @db.Uuid
  utility       Utility   @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name          String    @db.VarChar(100)
  effectiveDate DateTime  @map("effective_date") @db.Date
  /// Null until published. A published set is immutable.
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  /// How a non-TOU period spanning two seasons is decided (TOU-SEA-5).
  /// Only START_DATE is implemented — today's behaviour; the column
  /// exists so adopting MAJORITY or PRORATE is not a migration.
  spanRule      String    @default("START_DATE") @map("span_rule") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  seasons      Season[]
  touCalendars TouCalendar[]

  @@unique([utilityId, name], map: "season_set_name_per_tenant")
  @@unique([utilityId, id], map: "season_set_tenant_id_key")
  @@map("season_set")
}

/// One season: a month/day range that repeats every year and may wrap
/// the year end (Nov 1 – Mar 31). A set must cover every day of the
/// year exactly once, which `lib/rate-engine/seasons.ts` enforces —
/// the rule is a property of the set, so no CHECK can express it.
model Season {
  id          String   @id @default(uuid()) @db.Uuid
  utilityId   String   @map("utility_id") @db.Uuid
  utility     Utility  @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  seasonSetId String   @map("season_set_id") @db.Uuid
  seasonSet   SeasonSet @relation(fields: [utilityId, seasonSetId], references: [utilityId, id], onDelete: Cascade)
  /// What a tariff's `season` predicate compares against. Qualified,
  /// not a bare `code`, because the value travels: it is compared in the
  /// engine and will be named on every `tou_slot` row, where three such
  /// vocabularies meet (season, day type, peak) as bare strings.
  seasonCode  String   @map("season_code") @db.VarChar(50)
  label       String   @db.VarChar(100)
  startMonth  Int      @map("start_month") @db.SmallInt
  startDay    Int      @map("start_day") @db.SmallInt
  endMonth    Int      @map("end_month") @db.SmallInt
  endDay      Int      @map("end_day") @db.SmallInt
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, seasonSetId, seasonCode], map: "season_season_code_per_set")
  @@index([utilityId, seasonSetId, sortOrder], map: "season_set_idx")
  @@map("season")
}

/// Which hours cost what (spec 26, TOU-CAL-1 – 9).
///
/// Effective-dated, versioned and published like a rate schedule, and
/// for the same reason: changing which hours are on-peak changes what a
/// bill costs, so it is a new version with a date, never an edit to the
/// one that billed.
///
/// It names its **season set** rather than taking whichever set is in
/// force, because a published calendar is immutable: if the in-force set
/// changed, this calendar's spans would reference season codes that no
/// longer exist and the hours they price would resolve to nothing. The
/// tariff's seasons are part of the tariff (TOU-CAL-10).
///
/// `lib/rate-engine/tou-calendar.ts` classifies against it and
/// `tou-clock.ts` converts a stored UTC instant to the local wall clock
/// it classifies by.
model TouCalendar {
  id            String    @id @default(uuid()) @db.Uuid
  utilityId     String    @map("utility_id") @db.Uuid
  utility       Utility   @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name          String    @db.VarChar(100)
  effectiveDate DateTime  @map("effective_date") @db.Date
  /// Null until published. A published calendar is immutable.
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  seasonSetId   String    @map("season_set_id") @db.Uuid
  seasonSet     SeasonSet @relation(fields: [utilityId, seasonSetId], references: [utilityId, id], onDelete: Restrict)
  /// Null for a tariff that does not distinguish holidays, which is then
  /// never asked for holiday hours. The key itself is in the
  /// `tou_holiday_sets` migration — Prisma requires every referencing
  /// field of an optional composite relation to be optional, and
  /// `utility_id` is not.
  touHolidaySetId String? @map("tou_holiday_set_id") @db.Uuid
  /// IANA name, e.g. `America/Denver` (TOU-CAL-6). Belongs to the
  /// tariff, not the customer: where someone lives never changes which
  /// hours are on-peak.
  timeZone      String    @map("time_zone") @db.VarChar(64)
  /// `prevailing` follows daylight saving; `standard` means standard
  /// time all year, so a 4–9 pm peak runs 5–10 pm by the summer clock.
  clockBasis    String    @default("prevailing") @map("clock_basis") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // No `periods` — they belong to the tenant now, and a calendar's own
  // are the distinct codes its slots use. See `TouPeriod`.
  dayTypes  TouDayType[]
  slots     TouSlot[]
  overrides TouDayOverride[]
  weekdays  TouDayTypeWeekday[]

  @@unique([utilityId, name, effectiveDate], map: "tou_calendar_version_per_tenant")
  @@unique([utilityId, id], map: "tou_calendar_tenant_id_key")
  @@map("tou_calendar")
}

/// A price tier a tenant's TOU tariffs assign hours to: `peak`,
/// `off_peak`, `super_off_peak` (spec 26, TOU-CAL-1).
///
/// The table keeps the industry's word, since "TOU period" is what every
/// tariff document says, and the column keeps the one that is
/// unambiguous in code: `period` is already the service period, the
/// billing period and `BaseContext.period`, so a `periodCode` beside
/// `period.startDate` in the resolver would reintroduce the ambiguity
/// qualification removes. A period and a peak are the same thing here.
///
/// **Per tenant, not per calendar.** The codes were declared on each
/// calendar until 2026-11-04, which stored one fact twice — every
/// `meter_register`, `meter_read` and rate component already carried
/// the code as a plain string, and `tou_slot` was the only keyed
/// reference in the system.
///
/// A calendar's own periods are therefore **derived**: the distinct
/// codes its hours use. A four-code tenant may have a two-period
/// tariff, so nothing requires a calendar to use them all.
model TouPeriod {
  id        String   @id @default(uuid()) @db.Uuid
  utilityId String   @map("utility_id") @db.Uuid
  utility   Utility  @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  peakCode  String   @map("peak_code") @db.VarChar(50)
  label     String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  slots TouSlot[]

  /// The key the slots reference — on the code, not the id. See
  /// `TouSlot.peakCode`.
  @@unique([utilityId, peakCode], map: "tou_period_peak_code_per_tenant")
  @@map("tou_period")
}

/// A kind of day, which decides which hours are on-peak (TOU-CAL-2).
///
/// `dayTypeCode` is the tenant's own string and the vocabulary stays
/// **open** — Saturday priced apart from Sunday is a real tariff and a
/// fixed set of three could not express it.
///
/// **`holiday` is the one reserved code.** The system creates that day
/// type when a calendar names a holiday set, and `resolveDayType`
/// matches it directly. It replaced an `is_holiday` boolean, which
/// existed only because every code was the tenant's own and so none
/// could be matched — and which needed a partial unique index and a
/// validator rule to enforce "at most one". Reserving one code settles
/// all three: `tou_day_type_code_per_calendar` already makes it unique.
///
/// The reservation is enforced in `tou-calendar.service.ts`, not by a
/// CHECK: a constraint cannot tell the system's row from a tenant's.
model TouDayType {
  id            String      @id @default(uuid()) @db.Uuid
  utilityId     String      @map("utility_id") @db.Uuid
  utility       Utility     @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  touCalendarId String      @map("tou_calendar_id") @db.Uuid
  calendar      TouCalendar @relation(fields: [utilityId, touCalendarId], references: [utilityId, id], onDelete: Cascade)
  dayTypeCode   String      @map("day_type_code") @db.VarChar(50)
  label         String      @db.VarChar(100)
  sortOrder     Int         @default(0) @map("sort_order") @db.SmallInt
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  weekdays  TouDayTypeWeekday[]
  slots     TouSlot[]
  overrides TouDayOverride[]

  @@unique([utilityId, touCalendarId, dayTypeCode], map: "tou_day_type_code_per_calendar")
  @@unique([utilityId, touCalendarId, id], map: "tou_day_type_calendar_id_key")
  @@map("tou_day_type")
}

/// Which weekdays a day type covers (TOU-CAL-2).
///
/// A child table rather than seven boolean columns, because the
/// relationship is one-to-many and seven columns is the repeated column
/// group this codebase already decided against on `utility_config` —
/// where three such groups made adding the fourth cost a migration and
/// seven files.
///
/// It carries `touCalendarId` so a unique index can span the calendar,
/// which makes "no weekday is claimed by two day types" a database
/// guarantee. The other half — every weekday claimed — is a property of
/// the set, so `validateCalendar` owns it.
model TouDayTypeWeekday {
  id            String      @id @default(uuid()) @db.Uuid
  utilityId     String      @map("utility_id") @db.Uuid
  utility       Utility     @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  touCalendarId String      @map("tou_calendar_id") @db.Uuid
  calendar      TouCalendar @relation(fields: [utilityId, touCalendarId], references: [utilityId, id], onDelete: Cascade)
  touDayTypeId  String      @map("tou_day_type_id") @db.Uuid
  dayType       TouDayType  @relation(fields: [utilityId, touCalendarId, touDayTypeId], references: [utilityId, touCalendarId, id], onDelete: Cascade)
  /// ISO weekday: Monday is 1, Sunday is 7.
  isoWeekday    Int         @map("iso_weekday") @db.SmallInt

  @@unique([utilityId, touCalendarId, isoWeekday], map: "tou_day_type_weekday_once_per_calendar")
  @@map("tou_day_type_weekday")
}

/// A span of a day at one period, for one (season, day type).
///
/// Half-open minutes from local midnight: `startMinute` is included,
/// `endMinute` is not, which is what lets two adjacent spans tile
/// without the boundary minute being double-counted or lost.
///
/// Spans rather than 96 cells a day, because a span is what a tariff
/// document says ("on-peak 4–9 pm") and what a published diff has to
/// read back (TOU-UI-1d) — a painted grid cannot be summarised for a
/// regulator.
///
/// `seasonCode` and `peakCode` are codes where the day type is a key:
/// the day type is a child of this calendar, so a three-column key pins
/// it to this calendar, while a season lives in a separately versioned
/// set and a period is the tenant's — since 2026-11-04, when it stopped
/// being a key — and both codes have to travel to the engine anyway. An
/// **exclusion constraint** makes
/// "no two spans share a minute" a database guarantee; it exists only in
/// the `tou_calendar` migration, since Prisma cannot express one.
model TouSlot {
  id            String      @id @default(uuid()) @db.Uuid
  utilityId     String      @map("utility_id") @db.Uuid
  utility       Utility     @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  touCalendarId String      @map("tou_calendar_id") @db.Uuid
  calendar      TouCalendar @relation(fields: [utilityId, touCalendarId], references: [utilityId, id], onDelete: Cascade)
  seasonCode    String      @map("season_code") @db.VarChar(50)
  touDayTypeId  String      @map("tou_day_type_id") @db.Uuid
  dayType       TouDayType  @relation(fields: [utilityId, touCalendarId, touDayTypeId], references: [utilityId, touCalendarId, id], onDelete: Cascade)
  /// The price tier these minutes cost, as the **code** and not a key
  /// to the row.
  ///
  /// That is what makes a tenant-level `tou_period` safe. A published
  /// calendar is immutable so nothing can move under it — it names a
  /// season-set version and a holiday-set version for that reason — and
  /// the tenant's code list is unversioned. Holding the string means a
  /// published calendar's hours literally say `peak`, the rate
  /// component prices `peak`, and editing the list changes a label and
  /// the editor's picker, never what a bill meant.
  ///
  /// The foreign key is on the code, so a span cannot name a code the
  /// tenant has not defined, and a code in use can be neither deleted
  /// nor renamed. Refusing a rename is right: the code travels into
  /// rate components and meter registers.
  peakCode      String      @map("peak_code") @db.VarChar(50)
  period        TouPeriod   @relation(fields: [utilityId, peakCode], references: [utilityId, peakCode], onDelete: Restrict)
  /// Inclusive, and a multiple of 15 (TOU-CAL-1's granularity).
  startMinute   Int         @map("start_minute") @db.SmallInt
  /// Exclusive; 1440 is the end of the day.
  endMinute     Int         @map("end_minute") @db.SmallInt
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([utilityId, touCalendarId, seasonCode, touDayTypeId, startMinute], map: "tou_slot_lookup_idx")
  @@map("tou_slot")
}

/// One named date taking a different day type (TOU-CAL-9).
///
/// The narrowest statement a tenant can make, so it outranks both the
/// holiday list and the weekday coverage. This is the shape critical
/// peak pricing will use for event days, with no schema change.
model TouDayOverride {
  id            String      @id @default(uuid()) @db.Uuid
  utilityId     String      @map("utility_id") @db.Uuid
  utility       Utility     @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  touCalendarId String      @map("tou_calendar_id") @db.Uuid
  calendar      TouCalendar @relation(fields: [utilityId, touCalendarId], references: [utilityId, id], onDelete: Cascade)
  overrideDate  DateTime    @map("override_date") @db.Date
  touDayTypeId  String      @map("tou_day_type_id") @db.Uuid
  dayType       TouDayType  @relation(fields: [utilityId, touCalendarId, touDayTypeId], references: [utilityId, touCalendarId, id], onDelete: Cascade)
  /// Why this date is not an ordinary day — shown beside it in the
  /// editor and in a bill's footnote.
  reason        String?     @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, touCalendarId, overrideDate], map: "tou_day_override_date_per_calendar")
  @@map("tou_day_override")
}

/// A named set of holiday rules, shared across the tenant's calendars
/// (TOU-UI-2a), each calendar naming the list it uses — so adding a
/// Which dates are holidays (spec 26, TOU-CAL-4).
///
/// **Explicit dates, not rules.** A rule — "4 July, nearest weekday" —
/// is a computation nobody checked: it does not tell anybody that 2026
/// lands on a Saturday and moves the holiday to Friday the 3rd, a
/// weekday whose peak hours disappear. A date is the fact itself, and
/// the observance is applied by the person who knows it.
///
/// **Versioned and published like a season set**, and for the same
/// reason: a published calendar names a published version, so editing
/// a set cannot change which days got holiday hours on bills already
/// issued (TOU-CAL-10 argues this for seasons).
///
/// A set covers a horizon and runs out. `validateCalendar` reports a
/// year the calendar covers with no dates in its set, because the
/// alternative is every holiday that year quietly billing as an
/// ordinary weekday.
model TouHolidaySet {
  id            String    @id @default(uuid()) @db.Uuid
  utilityId     String    @map("utility_id") @db.Uuid
  utility       Utility   @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name          String    @db.VarChar(100)
  effectiveDate DateTime  @map("effective_date") @db.Date
  /// Null until published. A published set is immutable.
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  holidays TouHoliday[]

  @@unique([utilityId, name, effectiveDate], map: "tou_holiday_set_version_per_tenant")
  @@unique([utilityId, id], map: "tou_holiday_set_tenant_id_key")
  @@map("tou_holiday_set")
}

/// One date in a set. A real date with a year, which is the whole point
/// of leaving rules behind.
model TouHoliday {
  id              String        @id @default(uuid()) @db.Uuid
  utilityId       String        @map("utility_id") @db.Uuid
  utility         Utility       @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  touHolidaySetId String        @map("tou_holiday_set_id") @db.Uuid
  set             TouHolidaySet @relation(fields: [utilityId, touHolidaySetId], references: [utilityId, id], onDelete: Cascade)
  holidayDate     DateTime      @map("holiday_date") @db.Date
  name            String        @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, touHolidaySetId, holidayDate], map: "tou_holiday_date_per_set")
  @@index([utilityId, touHolidaySetId, holidayDate], map: "tou_holiday_set_date_idx")
  @@map("tou_holiday")
}
