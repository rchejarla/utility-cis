// Prisma schema for Utility CIS — all 17 entities
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  /// No `url` here: Prisma 7 refuses it in the schema (P1012). The URL
  /// that migrations connect with lives in `prisma.config.ts`, and the
  /// application passes a driver adapter to the client instead — the
  /// built-in query engine is gone in 7, so an adapter is mandatory
  /// rather than opt-in.
}

// ─── The tenant ───────────────────────────────────────────────────────────────

/// A utility is a tenant. Every other table carries its id as
/// `utility_id`; this is the row that id refers to.
///
/// Before this existed, a tenant was an uncontrolled UUID with no name,
/// no status and no foreign key — a typo was indistinguishable from a
/// new tenant, and tenants could only be listed by SELECT DISTINCT over
/// an arbitrary table. See docs/superpowers/specs/
/// 2026-10-17-tenancy-and-platform-admin-design.md, decision D6.
///
/// "Tenant" survives only as the name of the isolation mechanism —
/// `app.current_utility_id`, `withTenant()`, the `tenant_isolation`
/// policies. The thing itself is a Utility.
model Utility {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(255)
  status    UtilityStatus @default(ACTIVE)
  /// Whether this system is the tenant's system of record (spec 28,
  /// OVL-T-1). OVERLAY means a legacy CIS still bills the customers and
  /// we mirror it, so billing runs, AR posting, payments, delinquency
  /// actions and customer notifications are refused. Separate from
  /// `status`: a tenant is routinely ACTIVE and OVERLAY at once.
  operatingMode UtilityOperatingMode @default(FULL) @map("operating_mode")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz


  // Back-relations. Prisma requires both sides of a relation to be
  // declared; these exist so `utility_id` can be a foreign key.
  accountTypeDefs        AccountTypeDef[]
  accounts               Account[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  notes                  Note[]
  seasonSets             SeasonSet[]
  seasons                Season[]
  touCalendars           TouCalendar[]
  touPeriods             TouPeriod[]
  touDayTypes            TouDayType[]
  touDayTypeWeekdays     TouDayTypeWeekday[]
  touSlots               TouSlot[]
  touDayOverrides        TouDayOverride[]
  touHolidaySets         TouHolidaySet[]
  touHolidays            TouHoliday[]
  billDocuments          BillDocument[]
  billMessages           BillMessage[]
  billSegmentLines       BillSegmentLine[]
  billSegments           BillSegment[]
  billingAddresss        BillingAddress[]
  billingCycles          BillingCycle[]
  billingRunItems        BillingRunItem[]
  billingRuns            BillingRun[]
  bills                  Bill[]
  cisUsers               CisUser[]
  commoditys             Commodity[]
  contacts               Contact[]
  containers             Container[]
  customFieldSchemas     CustomFieldSchema[]
  customers              Customer[]
  delinquencyActions     DelinquencyAction[]
  delinquencyRules       DelinquencyRule[]
  importBatchs           ImportBatch[]
  importRows             ImportRow[]
  inAppNotifications     InAppNotification[]
  ledgerApplications     LedgerApplication[]
  ledgerEntrys           LedgerEntry[]
  ledgerReasonDefs       LedgerReasonDef[]
  measureTypeDefs        MeasureTypeDef[]
  meterEvents            MeterEvent[]
  meterDataExceptions    MeterDataException[]
  meterReads             MeterRead[]
  meterReadIntervals     MeterReadInterval[]
  meterRegisters         MeterRegister[]
  meters                 Meter[]
  notificationTemplates  NotificationTemplate[]
  notifications          Notification[]
  premiseTypeDefs        PremiseTypeDef[]
  premises               Premise[]
  rateAssignmentRoles    RateAssignmentRole[]
  rateComponentKinds     RateComponentKind[]
  rateComponents         RateComponent[]
  rateIndexs             RateIndex[]
  rateSchedules          RateSchedule[]
  rateServiceClasss      RateServiceClass[]
  roles                  Role[]
  sAScheduleAssignments  SAScheduleAssignment[]
  serviceAgreements      ServiceAgreement[]
  serviceEvents          ServiceEvent[]
  servicePointMeters     ServicePointMeter[]
  servicePoints          ServicePoint[]
  serviceRequestCounters ServiceRequestCounter[]
  serviceRequestTypeDefs ServiceRequestTypeDef[]
  serviceRequests        ServiceRequest[]
  serviceSuspensions     ServiceSuspension[]
  slas                   Sla[]
  suspensionTypeDefs     SuspensionTypeDef[]
  unitOfMeasures         UnitOfMeasure[]
  userPreferences        UserPreference[]
  userRoles              UserRole[]
  utilityConfigs         UtilityConfig[]
  schedulerConfigs       SchedulerConfig[]
  utilityModules         UtilityModule[]
  utilityVariables          UtilityVariable[]
  utilityThemes          UtilityTheme[]
  wqaValues              WqaValue[]

  @@map("utility")
}

enum UtilityStatus {
  ACTIVE
  SUSPENDED

  @@map("utility_status")
}

enum UtilityOperatingMode {
  /// This system is the system of record: it bills, posts and collects.
  FULL
  /// A legacy CIS is the system of record and we mirror it.
  OVERLAY

  @@map("utility_operating_mode")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum PremiseStatus {
  ACTIVE
  INACTIVE
  CONDEMNED

  @@map("premise_status")
}

/// How a meter is read. **Not** how its usage is split into TOU
/// periods — that is what a register's `peak_code` mapping declares,
/// and the two come apart in both directions (an AMR meter can carry
/// TOU registers; an AMI meter need not report intervals).
///
/// `SMART` was removed on 2026-11-06 as a second name for `AMI`.
/// PostgreSQL cannot drop a value from an enum, so the migration swaps
/// the type: see `meter_type_smart_removed`.
enum MeterType {
  AMR
  AMI
  MANUAL

  @@map("meter_type")
}

enum MeterStatus {
  ACTIVE
  REMOVED
  DEFECTIVE
  PENDING_INSTALL

  @@map("meter_status")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  FINAL
  CLOSED
  SUSPENDED

  @@map("account_status")
}

enum CreditRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNRATED

  @@map("credit_rating")
}

enum ServiceAgreementStatus {
  PENDING
  ACTIVE
  FINAL
  CLOSED

  @@map("service_agreement_status")
}

enum BillingFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY

  @@map("billing_frequency")
}

/// PARTIAL is a real outcome, not a half-failure: a run of twelve
/// thousand accounts that bills all but forty is the normal result, and
/// the forty are a work queue rather than a reason to call the run bad.
enum BillingRunStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED

  @@map("billing_run_status")
}

/// SKIPPED and FAILED are separate because only one of them is work.
/// Skipped is "nothing to bill" — no overlapping agreement, no unbilled
/// read, already billed for this window. Failed is "should have billed
/// and could not", which somebody has to act on. One errorCount would
/// bury the second in the first.
enum BillingRunItemStatus {
  PENDING
  BILLED
  SKIPPED
  FAILED

  @@map("billing_run_item_status")
}

enum ReadType {
  ACTUAL
  ESTIMATED
  CORRECTED
  FINAL
  AMI

  @@map("read_type")
}

enum ReadSource {
  MANUAL
  AMR
  AMI
  CUSTOMER_SELF
  SYSTEM

  @@map("read_source")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

enum ThemeMode {
  DARK
  LIGHT
  SYSTEM

  @@map("theme_mode")
}

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Commodity {
  id           String   @id @default(uuid()) @db.Uuid
  utilityId    String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code         String   @map("code") @db.VarChar(50)
  name         String   @map("name") @db.VarChar(100)
  defaultUomId String?  @map("default_uom_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  defaultUom         UnitOfMeasure?     @relation("DefaultUom", fields: [defaultUomId], references: [id], onDelete: SetNull)
  unitsOfMeasure     UnitOfMeasure[]    @relation("CommodityUoms")
  meters             Meter[]
  serviceAgreements  ServiceAgreement[]
  rateSchedules      RateSchedule[]
  delinquencyRules   DelinquencyRule[]
  rateServiceClasses RateServiceClass[]
  billMessages       BillMessage[]

  @@unique([utilityId, code])
  @@index([defaultUomId])
  @@map("commodity")
}

model UnitOfMeasure {
  id               String   @id @default(uuid()) @db.Uuid
  utilityId        String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code             String   @map("code") @db.VarChar(20)
  name             String   @map("name") @db.VarChar(100)
  commodityId      String   @map("commodity_id") @db.Uuid
  measureTypeId    String   @map("measure_type_id") @db.Uuid
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(15, 8)
  isBaseUnit       Boolean  @map("is_base_unit")
  isActive         Boolean  @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  commodity        Commodity       @relation("CommodityUoms", fields: [commodityId], references: [id], onDelete: Restrict)
  measureType      MeasureTypeDef  @relation(fields: [measureTypeId], references: [id], onDelete: Restrict)
  commodityDefault Commodity[]     @relation("DefaultUom")
  meters           Meter[]
  meterRegisters   MeterRegister[]
  meterReads       MeterRead[]
  meterReadIntervals MeterReadInterval[]

  @@unique([utilityId, commodityId, code])
  @@index([commodityId])
  @@index([measureTypeId])
  @@map("unit_of_measure")
}

// Reference catalog for measurement types (usage, demand, TOU peak, etc.).
// Same global + tenant-shadow pattern as SuspensionTypeDef: rows with
// utilityId NULL are global and visible to every tenant, while rows
// with a utility_id are tenant-local. Drives UOM grouping on commodities
// and register-type classification on meter registers.
model PremiseTypeDef {
  id          String   @id @default(uuid()) @db.Uuid
  utilityId   String?  @map("utility_id") @db.Uuid
  utility     Utility? @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code        String   @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(100) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, code])
  @@index([isActive, sortOrder])
  @@map("premise_type_def")
}

model AccountTypeDef {
  id          String   @id @default(uuid()) @db.Uuid
  utilityId   String?  @map("utility_id") @db.Uuid
  utility     Utility? @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code        String   @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(100) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  billMessages BillMessage[]

  @@unique([utilityId, code])
  @@index([isActive, sortOrder])
  @@map("account_type_def")
}

model MeasureTypeDef {
  id          String   @id @default(uuid()) @db.Uuid
  utilityId   String?  @map("utility_id") @db.Uuid
  utility     Utility? @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code        String   @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(100) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  unitsOfMeasure UnitOfMeasure[]
  meterRegisters MeterRegister[]

  @@unique([utilityId, code])
  @@index([isActive, sortOrder])
  @@map("measure_type_def")
}

model Premise {
  id                 String        @id @default(uuid()) @db.Uuid
  utilityId          String        @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  /// The id of the row this was mirrored from in a utility's legacy CIS
  /// (spec 28, OVL-IN-5). NULL on everything not created by an overlay
  /// import. Unique per tenant where present, via a **partial** unique
  /// index Prisma cannot express — see the legacy_key_mirror migration.
  legacyKey      String?   @map("legacy_key") @db.VarChar(255)
  addressLine1       String        @map("address_line1") @db.VarChar(255)
  addressLine2       String?       @map("address_line2") @db.VarChar(255)
  city               String        @map("city") @db.VarChar(100)
  state              String        @map("state") @db.Char(2)
  zip                String        @map("zip") @db.VarChar(10)
  geoLat             Decimal?      @map("geo_lat") @db.Decimal(9, 6)
  geoLng             Decimal?      @map("geo_lng") @db.Decimal(9, 6)
  premiseType        String        @map("premise_type") @db.VarChar(50)
  commodityIds       String[]      @map("commodity_ids") @db.Uuid
  serviceTerritoryId String?       @map("service_territory_id") @db.Uuid
  municipalityCode   String?       @map("municipality_code") @db.VarChar(50)
  status             PremiseStatus @default(ACTIVE) @map("status")
  ownerId            String?       @map("owner_id") @db.Uuid
  eruCount           Decimal?      @map("eru_count") @db.Decimal(8, 2)
  impervioussSqft    Int?          @map("impervious_sqft")
  hasStormwaterInfra Boolean       @default(false) @map("has_stormwater_infra")
  customFields       Json          @default("{}") @map("custom_fields")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Generated tsvector column — see FTS migration.
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Relations
  meters            Meter[]
  servicePoints     ServicePoint[]
  owner             Customer?          @relation("PremiseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  containers        Container[]
  serviceEvents     ServiceEvent[]
  serviceRequests   ServiceRequest[]

  @@index([utilityId, status])
  @@index([ownerId])
  @@index([utilityId, city, zip])
  @@map("premise")
}

model Meter {
  id           String      @id @default(uuid()) @db.Uuid
  utilityId    String      @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  /// The id of the row this was mirrored from in a utility's legacy CIS
  /// (spec 28, OVL-IN-5). NULL on everything not created by an overlay
  /// import. Unique per tenant where present, via a **partial** unique
  /// index Prisma cannot express — see the legacy_key_mirror migration.
  legacyKey      String?   @map("legacy_key") @db.VarChar(255)
  premiseId    String      @map("premise_id") @db.Uuid
  meterNumber  String      @map("meter_number") @db.VarChar(100)
  commodityId  String      @map("commodity_id") @db.Uuid
  meterType    MeterType   @map("meter_type")
  uomId        String      @map("uom_id") @db.Uuid
  dialCount    Int?        @map("dial_count")
  multiplier   Decimal     @default(1.0) @map("multiplier") @db.Decimal(10, 4)
  installDate  DateTime    @map("install_date") @db.Date
  removalDate  DateTime?   @map("removal_date") @db.Date
  status       MeterStatus @map("status")
  notes        String?     @map("notes") @db.Text
  customFields Json        @default("{}") @map("custom_fields")
  /// The TOU calendar version this meter is programmed with (spec 26,
  /// TOU-REG-2). A fact about the **device**: it records what we believe
  /// the firmware's switch times are, and it never decides pricing
  /// (TOU-CAL-11) — the rate schedule's own calendar does that.
  ///
  /// The mismatch check compares calendar **names**, not versions, so
  /// republishing a calendar does not flag every TOU meter in the
  /// territory. The key itself is in the `tou_registers` migration:
  /// Prisma requires every referencing field of an optional composite
  /// relation to be optional, and `utility_id` is not.
  touCalendarId String?    @map("tou_calendar_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Generated tsvector column — see FTS migration.
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Relations
  premise                Premise                 @relation(fields: [premiseId], references: [id], onDelete: Restrict)
  commodity              Commodity               @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  uom                    UnitOfMeasure           @relation(fields: [uomId], references: [id], onDelete: Restrict)
  meterReads             MeterRead[]
  meterReadIntervals     MeterReadInterval[]
  dataExceptions         MeterDataException[]
  servicePointMeters     ServicePointMeter[]
  registers              MeterRegister[]
  events                 MeterEvent[]

  @@unique([utilityId, meterNumber])
  @@index([premiseId])
  @@index([commodityId])
  @@index([uomId])
  @@index([utilityId, status])
  @@map("meter")
}

model Account {
  id                  String        @id @default(uuid()) @db.Uuid
  utilityId           String        @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  /// The id of the row this was mirrored from in a utility's legacy CIS
  /// (spec 28, OVL-IN-5). NULL on everything not created by an overlay
  /// import. Unique per tenant where present, via a **partial** unique
  /// index Prisma cannot express — see the legacy_key_mirror migration.
  legacyKey      String?   @map("legacy_key") @db.VarChar(255)
  accountNumber       String        @map("account_number") @db.VarChar(50)
  customerId          String?       @map("customer_id") @db.Uuid
  accountType         String        @map("account_type") @db.VarChar(50)
  status              AccountStatus @map("status")
  creditRating        CreditRating  @default(UNRATED) @map("credit_rating")
  /// Cache of SUM(open DEPOSIT ledger entries), like `balance` is a
  /// cache of the receivable. Written only inside the transaction that
  /// writes the entry, and proved by GET /api/v1/ar/reconciliation.
  depositAmount       Decimal       @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  /// A standing hold: bills for this account are born held, carrying
  /// this reason. Billing still happens — an unbilled period rolls up
  /// into the next one — but nothing leaves and nothing posts.
  billingHoldReason   String?       @map("billing_hold_reason") @db.VarChar(500)
  depositWaived       Boolean       @default(false) @map("deposit_waived")
  depositWaivedReason String?       @map("deposit_waived_reason") @db.VarChar(255)
  languagePref        String        @default("en-US") @map("language_pref") @db.Char(5)
  paperlessBilling    Boolean       @default(false) @map("paperless_billing")
  budgetBilling       Boolean       @default(false) @map("budget_billing")
  billingCycleId      String        @map("billing_cycle_id") @db.Uuid
  saaslogicAccountId  String?       @map("saaslogic_account_id") @db.Uuid
  balance             Decimal       @default(0) @map("balance") @db.Decimal(14, 2)
  autoPostBills       Boolean?      @map("auto_post_bills")
  lastDueDate         DateTime?     @map("last_due_date") @db.Date
  isProtected         Boolean       @default(false) @map("is_protected")
  protectionReason    String?       @map("protection_reason") @db.Text
  customFields        Json          @default("{}") @map("custom_fields")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  closedAt            DateTime?     @map("closed_at") @db.Timestamptz

  // Generated tsvector column — see FTS migration.
  searchVector Unsupported("tsvector")? @map("search_vector")

  // Relations
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  billingCycle       BillingCycle        @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)
  serviceAgreements  ServiceAgreement[]
  contacts           Contact[]
  billingAddresses   BillingAddress[]
  delinquencyActions DelinquencyAction[]
  serviceRequests    ServiceRequest[]
  userRoles          UserRole[]
  bills              Bill[]
  ledgerEntries      LedgerEntry[]

  @@unique([utilityId, accountNumber])
  @@index([customerId])
  @@index([utilityId, status])
  @@index([utilityId, balance])
  @@index([utilityId, billingCycleId])
  billingRunItems BillingRunItem[]

  @@map("account")
}

model ServiceAgreement {
  id              String                 @id @default(uuid()) @db.Uuid
  utilityId       String                 @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  /// The id of the row this was mirrored from in a utility's legacy CIS
  /// (spec 28, OVL-IN-5). NULL on everything not created by an overlay
  /// import. Unique per tenant where present, via a **partial** unique
  /// index Prisma cannot express — see the legacy_key_mirror migration.
  legacyKey      String?   @map("legacy_key") @db.VarChar(255)
  agreementNumber String                 @map("agreement_number") @db.VarChar(50)
  accountId       String                 @map("account_id") @db.Uuid
  commodityId     String                 @map("commodity_id") @db.Uuid
  startDate       DateTime               @map("start_date") @db.Date
  endDate         DateTime?              @map("end_date") @db.Date
  status          ServiceAgreementStatus @default(PENDING) @map("status")
  readSequence    Int?                   @map("read_sequence")
  rateServiceClassId String?             @map("rate_service_class_id") @db.Uuid
  customFields    Json                   @default("{}") @map("custom_fields")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  /// Generated tsrange [start_date, end_date) — DB-managed, read-only at the
  /// application layer. Source of truth for the no_overlapping_active_sa
  /// exclusion constraint. Service code uses start_date/end_date directly.
  effectiveRange  Unsupported("tsrange")? @map("effective_range")

  // Relations
  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  commodity       Commodity               @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  rateServiceClass RateServiceClass?      @relation(fields: [rateServiceClassId], references: [id], onDelete: SetNull)
  servicePoints   ServicePoint[]
  meterReads      MeterRead[]
  containers      Container[]
  suspensions     ServiceSuspension[]
  serviceEvents   ServiceEvent[]
  serviceRequests ServiceRequest[]
  rateScheduleAssignments SAScheduleAssignment[]
  wqaValues       WqaValue[]
  billSegments    BillSegment[]

  @@unique([utilityId, agreementNumber])
  @@index([accountId])
  @@index([commodityId])
  @@index([utilityId, status])
  @@index([rateServiceClassId])
  @@map("service_agreement")
}

/// Per-place service-delivery anchor between SA and Premise. One
/// SA can have multiple SPs (multi-premise commercial accounts,
/// master/sub-meter); each SP belongs to exactly one Premise. SP
/// type controls whether meters or items hang off it; Slice 1
/// only uses METERED.
enum ServicePointType {
  METERED
  ITEM_BASED
  NON_BADGED

  @@map("service_point_type")
}

enum ServicePointStatus {
  PENDING
  ACTIVE
  FINAL
  CLOSED

  @@map("service_point_status")
}

model ServicePoint {
  id                 String              @id @default(uuid()) @db.Uuid
  utilityId          String              @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  serviceAgreementId String              @map("service_agreement_id") @db.Uuid
  premiseId          String              @map("premise_id") @db.Uuid
  type               ServicePointType   @default(METERED) @map("type")
  status             ServicePointStatus @default(ACTIVE) @map("status")
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime?           @map("end_date") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  serviceAgreement ServiceAgreement     @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)
  premise          Premise              @relation(fields: [premiseId], references: [id], onDelete: Restrict)
  meters           ServicePointMeter[]

  @@index([serviceAgreementId])
  @@index([premiseId])
  @@index([utilityId, status])
  @@map("service_point")
}

/// SP ↔ Meter assignment with effective dates. Replaces SAM. At
/// most one ACTIVE row per (meter_id) at any instant — enforced by
/// the partial exclusion constraint defined in the migration.
model ServicePointMeter {
  id              String    @id @default(uuid()) @db.Uuid
  utilityId       String    @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  servicePointId  String    @map("service_point_id") @db.Uuid
  meterId         String    @map("meter_id") @db.Uuid
  addedDate       DateTime  @map("added_date") @db.Date
  removedDate     DateTime? @map("removed_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Generated tsrange [added_date, removed_date) — DB-managed, read-only.
  effectiveRange  Unsupported("tsrange")? @map("effective_range")

  servicePoint ServicePoint @relation(fields: [servicePointId], references: [id], onDelete: Cascade)
  meter        Meter        @relation(fields: [meterId], references: [id], onDelete: Restrict)

  @@index([servicePointId])
  @@index([meterId])
  @@map("service_point_meter")
}

model RateSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  utilityId      String    @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name           String    @map("name") @db.VarChar(255)
  code           String    @map("code") @db.VarChar(50)
  commodityId    String    @map("commodity_id") @db.Uuid
  effectiveDate  DateTime  @map("effective_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
  description    String?   @map("description") @db.Text
  regulatoryRef  String?   @map("regulatory_ref") @db.VarChar(100)
  version        Int       @default(1) @map("version")
  supersedesId   String?   @map("supersedes_id") @db.Uuid
  supersededById String?   @map("superseded_by_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  /// The TOU calendar version this schedule's TOU components are written
  /// against (spec 26, TOU-CAL-10). NULL for a non-TOU schedule.
  ///
  /// On the schedule rather than on each component, because the
  /// components of one tariff share one set of peak hours — repeated per
  /// component, two of them could name different calendars, which has no
  /// coherent meaning but would save and bill.
  ///
  /// A specific **version**, because a published schedule is immutable
  /// and must keep meaning what it meant: it cannot follow a calendar
  /// republished with different hours. New hours mean a new schedule
  /// version against the new calendar version.
  ///
  /// The key is in the `rate_schedule_tou_calendar` migration — Prisma
  /// requires every referencing field of an optional composite relation
  /// to be optional, and `utility_id` is not.
  touCalendarId  String?   @map("tou_calendar_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  commodity         Commodity          @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  supersedes        RateSchedule?      @relation("RateScheduleVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy      RateSchedule[]     @relation("RateScheduleVersions")
  components        RateComponent[]
  saAssignments     SAScheduleAssignment[]
  billSegmentLines  BillSegmentLine[]

  @@unique([utilityId, code, version])
  @@index([commodityId])
  @@index([supersedesId])
  @@index([utilityId, effectiveDate, expirationDate])
  @@map("rate_schedule")
}

model RateComponent {
  id              String    @id @default(uuid()) @db.Uuid
  utilityId       String    @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  rateScheduleId  String    @map("rate_schedule_id") @db.Uuid
  kindCode        String    @map("kind_code") @db.VarChar(50)
  label           String    @map("label") @db.VarChar(255)
  predicate       Json      @map("predicate")
  quantitySource  Json      @map("quantity_source")
  pricing         Json      @map("pricing")
  sortOrder       Int       @default(100) @map("sort_order")
  effectiveDate   DateTime  @map("effective_date") @db.Date
  expirationDate  DateTime? @map("expiration_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  rateSchedule    RateSchedule @relation(fields: [rateScheduleId], references: [id], onDelete: Cascade)
  billSegmentLines BillSegmentLine[]

  @@index([rateScheduleId])
  @@index([utilityId, rateScheduleId, sortOrder])
  @@index([kindCode])
  @@map("rate_component")
}

/// Slice 1 task 6 — SA-to-RateSchedule join. One SA can hold N schedules
/// each with a role (delivery/supply/rider/...) and its own effective
/// dating window. Tenant scope enforced at insert by the service layer
/// AND by the standard RLS policy on utility_id. Overlap exclusion is
/// deferred to slice 2/3.
model SAScheduleAssignment {
  id                  String   @id @default(uuid()) @db.Uuid
  utilityId           String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  serviceAgreementId  String   @map("service_agreement_id") @db.Uuid
  rateScheduleId      String   @map("rate_schedule_id") @db.Uuid
  roleCode            String   @map("role_code") @db.VarChar(50)
  effectiveDate       DateTime @map("effective_date") @db.Date
  expirationDate      DateTime? @map("expiration_date") @db.Date
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceAgreement    ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)
  rateSchedule        RateSchedule     @relation(fields: [rateScheduleId], references: [id], onDelete: Restrict)

  @@index([serviceAgreementId, effectiveDate])
  @@index([rateScheduleId])
  @@index([roleCode])
  @@map("sa_rate_schedule_assignment")
}

/// Slice 1 task 7 — RateIndex backs pricing.type = "indexed". Each row
/// is a (name, period) value snapshot with its own effective dating
/// window — FAC, EPCC, supply quarterlies, drought_reserve_rate, etc.
/// Components reference indexes by name; the engine resolves the period
/// at evaluation time (current_quarter, prior_month, ...).
model RateIndex {
  id              String   @id @default(uuid()) @db.Uuid
  utilityId       String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name            String   @map("name") @db.VarChar(50)
  period          String   @map("period") @db.VarChar(20)
  value           Decimal  @map("value") @db.Decimal(18, 8)
  effectiveDate   DateTime @map("effective_date") @db.Date
  expirationDate  DateTime? @map("expiration_date") @db.Date
  description     String?  @map("description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, name, period])
  @@index([utilityId, name, effectiveDate])
  @@map("rate_index")
}

model BillingCycle {
  id             String           @id @default(uuid()) @db.Uuid
  utilityId      String           @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name           String           @map("name") @db.VarChar(255)
  cycleCode      String           @map("cycle_code") @db.VarChar(20)
  /// The day meter reads are expected to be complete by, which is what
  /// makes a bill day meaningful: billing a cycle before its reads are
  /// in produces a bill for zero usage, and then a double one next
  /// period when both reads land in the same window. Required — a cycle
  /// that cannot say when its reads are due cannot safely be billed, so
  /// "not declared" is not a state worth modelling. Must precede
  /// `billDayOfMonth` (BR-BC-001).
  readDayOfMonth Int              @map("read_day_of_month")
  billDayOfMonth Int              @map("bill_day_of_month")
  frequency      BillingFrequency @default(MONTHLY) @map("frequency")
  active         Boolean          @default(true) @map("active")

  // Relations
  accounts       Account[]
  bills          Bill[]
  billingRuns    BillingRun[]

  @@unique([utilityId, cycleCode])
  @@index([utilityId, active])
  @@map("billing_cycle")
}

/// Slice 5a — persisted output of the v2 rate engine for one SA + one period.
/// Industry term: per-SA charge calculation. Customer-facing "Bill" / Statement
/// (per-account aggregate) is a separate entity to be added in 5b. Immutable
/// financial record; Slice 5c (rebill) will add a self-relation to chain
/// corrections — for now each segment is a leaf.
model BillSegment {
  id                   String   @id @default(uuid()) @db.Uuid
  utilityId            String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  serviceAgreementId   String   @map("service_agreement_id") @db.Uuid
  /// Slice 5b.2 — once an account-level Bill aggregates this segment,
  /// `bill_id` is set to it. Null = not yet on a Bill. At-most-one is
  /// enforced structurally by this column being singular (no join table).
  billId               String?  @map("bill_id") @db.Uuid
  periodStart          DateTime @map("period_start") @db.Date
  periodEnd            DateTime @map("period_end") @db.Date
  subtotal             Decimal  @map("subtotal") @db.Decimal(14, 4)
  taxes                Decimal  @map("taxes") @db.Decimal(14, 4)
  credits              Decimal  @map("credits") @db.Decimal(14, 4)
  total                Decimal  @map("total") @db.Decimal(14, 4)
  minimumFloorApplied  Boolean  @map("minimum_floor_applied")
  segmentNumber        String   @map("segment_number") @db.VarChar(50)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  serviceAgreement     ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Restrict)
  bill                 Bill?            @relation(fields: [billId], references: [id], onDelete: Restrict)
  lines                BillSegmentLine[]

  @@unique([utilityId, segmentNumber])
  @@index([utilityId, serviceAgreementId, periodStart])
  @@index([utilityId, periodEnd])
  @@index([utilityId, billId])
  @@map("bill_segment")
}

model BillSegmentLine {
  id                  String   @id @default(uuid()) @db.Uuid
  utilityId           String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  billSegmentId       String   @map("bill_segment_id") @db.Uuid
  label               String   @map("label") @db.VarChar(255)
  kindCode            String   @map("kind_code") @db.VarChar(50)
  amount              Decimal  @map("amount") @db.Decimal(14, 4)
  quantity            Decimal? @map("quantity") @db.Decimal(14, 4)
  /// What `quantity` is counted in. The tariff's unit, which is not
  /// always the meter's: the engine converts, so a gallons meter on an
  /// HCF tariff bills 6.6279 and the bill has to say of what.
  unit                String?  @map("unit") @db.VarChar(20)
  sourceScheduleId    String   @map("source_schedule_id") @db.Uuid
  sourceComponentId   String   @map("source_component_id") @db.Uuid
  sortOrder           Int      @map("sort_order")

  billSegment         BillSegment   @relation(fields: [billSegmentId], references: [id], onDelete: Cascade)
  sourceSchedule      RateSchedule  @relation(fields: [sourceScheduleId], references: [id], onDelete: Restrict)
  sourceComponent     RateComponent @relation(fields: [sourceComponentId], references: [id], onDelete: Restrict)

  @@index([billSegmentId, sortOrder])
  @@index([utilityId, sourceComponentId])
  @@map("bill_segment_line")
}

/// Slice 5b.2 — per-Account, per-period customer-facing bill. Aggregates
/// many BillSegments (one per service the Account holds). Industry term
/// for the customer-facing document — Oracle CC&B "Bill"; SAP IS-U
/// billing document at Contract Account level. Immutable once issued;
/// future Slice 5d (rebill / corrections) will introduce a supersedes
/// pointer if needed.
model Bill {
  id                   String   @id @default(uuid()) @db.Uuid
  utilityId            String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  accountId            String   @map("account_id") @db.Uuid
  /// Cycle in effect at issue time. Materialized so a later cycle switch
  /// on the Account doesn't rewrite history.
  billingCycleId       String   @map("billing_cycle_id") @db.Uuid
  periodStart          DateTime @map("period_start") @db.Date
  periodEnd            DateTime @map("period_end") @db.Date
  billDate             DateTime @map("bill_date") @db.Date
  dueDate              DateTime @map("due_date") @db.Date
  /// Why this bill is held, or null if it is not. A held bill cannot be
  /// posted and cannot be delivered; it is neither cancelled nor
  /// reversed, and nothing further happens to it until released. The
  /// column *is* the hold, so placing one requires a reason. Who held it
  /// and when comes from the audit log, which is why there is no
  /// `bill_hold` entity. A partial index on (utility_id) WHERE
  /// hold_reason IS NOT NULL lives in SQL only.
  holdReason           String?  @map("hold_reason") @db.VarChar(500)
  subtotal             Decimal  @map("subtotal") @db.Decimal(14, 4)
  taxes                Decimal  @map("taxes") @db.Decimal(14, 4)
  credits              Decimal  @map("credits") @db.Decimal(14, 4)
  total                Decimal  @map("total") @db.Decimal(14, 4)
  /// Where the account stood when this bill was issued, frozen at
  /// posting. `Decimal(14,2)` and not the 4dp above, because these are
  /// sums of `ledger_entry.amount`: rating works in 4dp and the ledger
  /// does not.
  ///
  /// Null together on a bill issued before 2026-10-26 — a CHECK requires
  /// all three or none — and then the presentation omits the statement
  /// lines rather than inventing them. There is no backfill because the
  /// figures are not recoverable: `reverseEntry` deletes the
  /// `ledger_application` rows it undoes, so a past balance cannot be
  /// reconstructed once a payment has been reversed. That is the same
  /// fact that makes freezing them necessary rather than recomputing at
  /// render.
  ///
  /// `previousBalance` may be negative — an account in credit at the last
  /// bill carried that credit forward. The other two may not, and
  /// CHECKs say so.
  previousBalance      Decimal? @map("previous_balance") @db.Decimal(14, 2)
  /// Positive, and subtracted in the layout, the way every bill in the
  /// trade prints payments.
  paymentsSince        Decimal? @map("payments_since") @db.Decimal(14, 2)
  pastDueAmount        Decimal? @map("past_due_amount") @db.Decimal(14, 2)
  billNumber           String   @map("bill_number") @db.VarChar(50)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  postedAt             DateTime? @map("posted_at") @db.Timestamptz

  account              Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  billingCycle         BillingCycle  @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)
  segments             BillSegment[]
  ledgerEntries        LedgerEntry[]
  documents            BillDocument[]
  /// Every attempt to deliver this bill, newest first by index.
  deliveries           Notification[]

  @@unique([utilityId, billNumber])
  @@index([utilityId, accountId, periodEnd])
  @@index([utilityId, dueDate])
  billingRunItems BillingRunItem[]

  @@map("bill")
}

model MeterRead {
  id                 String     @default(uuid()) @db.Uuid
  utilityId          String     @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  meterId            String     @map("meter_id") @db.Uuid
  serviceAgreementId String     @map("service_agreement_id") @db.Uuid
  registerId         String?    @map("register_id") @db.Uuid
  readEventId        String?    @map("read_event_id") @db.Uuid
  uomId              String     @map("uom_id") @db.Uuid
  readDate           DateTime   @map("read_date") @db.Date
  readDatetime       DateTime   @map("read_datetime") @db.Timestamptz
  /// Optional since the `tou_registers` migration. A register-based
  /// read has a dial reading; an interval-derived TOU bucket is a sum
  /// over classified intervals and has none, and inventing one would put
  /// a number on a bill that matches nothing on the device. A CHECK
  /// keeps the pair together — `consumption` is their difference, so one
  /// without the other is a record whose consumption cannot be checked.
  reading            Decimal?   @map("reading") @db.Decimal(12, 4)
  priorReading       Decimal?   @map("prior_reading") @db.Decimal(12, 4)
  /// Always present: the thing every read has and rating uses.
  consumption        Decimal    @map("consumption") @db.Decimal(12, 4)
  /// Which TOU period this row's consumption belongs to (spec 26).
  /// NULL for a total read, which is every row written before
  /// 2026-11-03.
  ///
  /// Carried here as well as being derivable from the register, because
  /// the two meter kinds must produce one shape: a register-based bucket
  /// takes the code from its register, an interval-derived one is
  /// classified by the calendar and has no register. A code rather than
  /// a key to `tou_period`, which is tenant-level — so the key would now
  /// be expressible, and is still refused here on volume: this is a
  /// hypertable taking tens of millions of rows a month at TOU
  /// granularity.
  peakCode           String?    @map("peak_code") @db.VarChar(50)
  readType           ReadType   @map("read_type")
  readSource         ReadSource @map("read_source")
  exceptionCode      String?    @map("exception_code") @db.VarChar(50)
  exceptionNotes     String?    @map("exception_notes") @db.Text
  readerId           String?    @map("reader_id") @db.Uuid
  isFrozen           Boolean    @default(false) @map("is_frozen")
  billedAt           DateTime?  @map("billed_at") @db.Timestamptz
  importBatchId      String?    @map("import_batch_id") @db.Uuid
  correctsReadId     String?    @map("corrects_read_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  meter            Meter            @relation(fields: [meterId], references: [id], onDelete: Restrict)
  serviceAgreement ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Restrict)
  register         MeterRegister?   @relation(fields: [registerId], references: [id], onDelete: SetNull)
  uom              UnitOfMeasure    @relation(fields: [uomId], references: [id], onDelete: Restrict)

  // Composite PK: TimescaleDB hypertables require the partition column
  // (readDatetime) to appear in every unique constraint, including the PK.
  // Service code that only knows `id` must use `findFirst({ where: { id, utilityId } })`
  // rather than `findUnique`.
  @@id([id, readDatetime])
  @@index([id])
  @@index([meterId, readDatetime])
  @@index([serviceAgreementId, readDatetime])
  @@index([registerId])
  @@index([utilityId, importBatchId])
  @@index([utilityId, readEventId])
  @@map("meter_read")
}

/// Interval consumption — one row per interval per meter or register
/// (spec 26, TOU-INT-1).
///
/// The second of the two ways a TOU bucket exists. A register meter
/// splits usage itself and its mapping says what each dial means; an
/// interval meter reports one quantity per interval and the published
/// calendar classifies them. Both end as `meter_read` rows carrying a
/// `peak_code`, so the rate engine never learns which kind of meter
/// produced one.
///
/// `interval_start` is always UTC. The source's basis is resolved at
/// import (TOU-INT-2a) and never stored half-converted — a column that
/// sometimes means local time is how every interval ends up an hour
/// out with nothing raised.
///
/// A hypertable, chunked by week. The CHECK constraints on
/// `lengthMinutes` and `quality`, the two partial unique indexes that
/// make an import idempotent, the tenant-scoped foreign keys and the
/// RLS policy are all in the `meter_read_interval` migration — none of
/// them can be expressed here.
model MeterReadInterval {
  id            String   @default(uuid()) @db.Uuid
  utilityId     String   @map("utility_id") @db.Uuid
  utility       Utility  @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  meterId       String   @map("meter_id") @db.Uuid
  /// A bare scalar, not a relation: the key is
  /// `(utility_id, register_id) -> meter_register (utility_id, id)` in
  /// the migration, and Prisma requires every referencing field of an
  /// optional composite relation to be optional — `utility_id` is not.
  registerId    String?  @map("register_id") @db.Uuid
  uomId         String   @map("uom_id") @db.Uuid
  intervalStart DateTime @map("interval_start") @db.Timestamptz
  lengthMinutes Int      @map("length_minutes") @db.SmallInt
  quantity      Decimal  @db.Decimal(18, 6)
  /// actual | estimated | missing | edited. `missing` is a row rather
  /// than an absence: a gap the utility knows about reads differently
  /// from one nobody has noticed.
  quality       String   @default("actual") @db.VarChar(20)
  importBatchId String?  @map("import_batch_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  meter Meter         @relation(fields: [meterId], references: [id], onDelete: Restrict)
  uom   UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)

  /// TimescaleDB requires the partitioning column in every unique
  /// constraint, the primary key included.
  @@id([id, intervalStart])
  @@index([meterId, intervalStart])
  @@index([utilityId, importBatchId])
  @@map("meter_read_interval")
}

/// A day of one meter's data that cannot be billed as it stands
/// (spec 26, TOU-GAP-1).
///
/// The interval-coverage sweep's output, as work rather than a log
/// line. One row per (meter, window, kind) **while open** — a partial
/// unique index that exists only in the migration, because the history
/// has to stay: a gap resolved in March and back in April is two
/// exceptions, and a meter that fails every month is the pattern worth
/// seeing.
///
/// `windowStart` is the day the sweep examined, not the gap's own
/// start. That is what makes tonight's sighting of last night's hole
/// find its own row, and several holes in one day one exception whose
/// minutes sum.
///
/// **The sweep writes `open` and `resolved` only.** Both are facts
/// about the data — the intervals are there or they are not — so a
/// sweep that finds a hole filled closes its own row. `accepted` (bill
/// it as it stands) and `estimated` (a value was supplied) are
/// judgements, and no scheduled job makes those. A CHECK ties
/// `resolvedAt` to `status` both ways.
///
/// There is no `createdAt`: `detectedAt` is that timestamp under the
/// name that says what it means here.
model MeterDataException {
  id              String    @id @default(uuid()) @db.Uuid
  utilityId       String    @map("utility_id") @db.Uuid
  utility         Utility   @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  meterId         String    @map("meter_id") @db.Uuid
  windowStart     DateTime  @map("window_start") @db.Timestamptz
  windowEnd       DateTime  @map("window_end") @db.Timestamptz
  /// gap | overlap | overrun | missing_reading, by CHECK. The first
  /// three come from tiling; the fourth is the roll-up's quality check,
  /// which has no flag action until step 4.
  kind            String    @db.VarChar(30)
  minutesAffected Int       @map("minutes_affected")
  detail          String    @db.Text
  status          String    @default("open") @db.VarChar(20)
  detectedAt      DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// Single-column here, composite in the migration — the key is
  /// `(utility_id, meter_id) -> meter (utility_id, id)`, as it is for
  /// `meter_read_interval` beside it, so the two rows cannot belong to
  /// different tenants.
  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([utilityId, status, windowStart], map: "meter_data_exception_open_by_window")
  @@map("meter_data_exception")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  utilityId   String      @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String      @map("entity_id") @db.Uuid
  action      AuditAction @map("action")
  actorId     String?     @map("actor_id") @db.Uuid
  actorName   String?     @map("actor_name") @db.VarChar(255)
  // Distinguishes audit origin. User-action audits get the literal
  // "user:<cisUserId>"; scheduler-emitted audits get "scheduler:<queue-name>"
  // (e.g., "scheduler:suspension-transitions"). The audit-retention
  // sweep filters on source LIKE 'scheduler:%' so user audits stay
  // outside its scope.
  source      String?     @map("source") @db.VarChar(100)
  beforeState Json?       @map("before_state")
  afterState  Json?       @map("after_state")
  metadata    Json?       @map("metadata")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([utilityId, entityType, entityId])
  @@index([utilityId, createdAt])
  @@index([utilityId, actorId, createdAt])
  @@index([utilityId, source, createdAt])
  @@map("audit_log")
}

model UtilityTheme {
