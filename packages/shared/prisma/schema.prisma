  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([utilityId, status])
  @@index([meterId, eventDatetime])
  @@index([utilityId, eventType, status])
  @@map("meter_event")
}

enum ContainerType {
  CART_GARBAGE
  CART_RECYCLING
  CART_ORGANICS
  CART_YARD_WASTE
  DUMPSTER
  ROLL_OFF
}

enum ContainerStatus {
  ACTIVE
  SUSPENDED
  RETURNED
  LOST
  DAMAGED
}

model Container {
  id                 String          @id @default(uuid()) @db.Uuid
  utilityId          String          @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  premiseId          String          @map("premise_id") @db.Uuid
  serviceAgreementId String?         @map("service_agreement_id") @db.Uuid
  containerType      ContainerType   @map("container_type")
  sizeGallons        Int             @map("size_gallons")
  quantity           Int             @default(1) @map("quantity")
  serialNumber       String?         @map("serial_number") @db.VarChar(100)
  rfidTag            String?         @map("rfid_tag") @db.VarChar(100)
  status             ContainerStatus @default(ACTIVE) @map("status")
  deliveryDate       DateTime        @map("delivery_date") @db.Date
  removalDate        DateTime?       @map("removal_date") @db.Date
  ramsContainerId    String?         @map("rams_container_id") @db.VarChar(100)
  locationNotes      String?         @map("location_notes") @db.VarChar(500)
  size               String?         @map("size") @db.VarChar(20)
  frequency          String?         @map("frequency") @db.VarChar(20)
  itemType           String?         @map("item_type") @db.VarChar(50)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  premise          Premise           @relation(fields: [premiseId], references: [id], onDelete: Restrict)
  serviceAgreement ServiceAgreement? @relation(fields: [serviceAgreementId], references: [id], onDelete: SetNull)
  serviceEvents    ServiceEvent[]

  @@index([utilityId, premiseId])
  @@index([utilityId, serviceAgreementId])
  @@index([utilityId, serialNumber])
  @@index([utilityId, status])
  @@map("container")
}

enum SuspensionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// Per-tenant schema definitions for custom fields on extendable
// entities (Customer, Account, Premise, ServiceAgreement, Meter).
// One row per (utility_id, entity_type). The `fields` jsonb column
// holds a FieldDefinition[] array — see packages/shared/src/lib/
// custom-fields.ts for the TypeScript shape. Absence of a row means
// "this tenant has not configured any custom fields for this entity"
// and the customFields column on the corresponding entity row will
// simply be an empty object.
//
// The schema is authoritative: validateCustomFields on the API side
// loads the row, builds a Zod validator from the fields array, and
// uses it to reject unknown keys or type-mismatched values at write
// time. The web form uses the same shape to render inputs.
model CustomFieldSchema {
  id         String   @id @default(uuid()) @db.Uuid
  utilityId  String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  entityType String   @map("entity_type") @db.VarChar(50)
  fields     Json     @default("[]") @map("fields")
  version    Int      @default(1) @map("version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, entityType])
  @@map("custom_field_schema")
}

// Tenant-level configuration for service-hold behaviour. Lives alongside
// UtilityTheme/UtilityModule. A row is created lazily the first time a flag
// is set; absence of a row means "all defaults".
model UtilityConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  utilityId           String   @unique @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  requireHoldApproval Boolean  @default(false) @map("require_hold_approval")
  settings            Json     @default("{}") @map("settings")

  // ─── Automation settings that are not per-scheduler ───────────────
  // Everything a tenant may configure about *one* background job moved
  // to `SchedulerConfig` — a row per job rather than a column group per
  // job. What remains is what belongs to the tenant as a whole.
  timezone                    String    @default("UTC") @map("timezone") @db.VarChar(64)
  notificationQuietStart      String    @default("22:00") @map("notification_quiet_start") @db.VarChar(5)
  notificationQuietEnd        String    @default("07:00") @map("notification_quiet_end") @db.VarChar(5)
  schedulerAuditRetentionDays Int       @default(365) @map("scheduler_audit_retention_days")
  autoPostBills               Boolean   @default(true) @map("auto_post_bills")

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("utility_config")
}

/// What a tenant may configure about one background job.
///
/// One row per (utility, scheduler). Replaces three repeated groups of
/// columns on `UtilityConfig` — a one-to-many that had been modelled as
/// repeated column groups, so adding a scheduler cost a migration.
/// Adding one is now an INSERT, and onboarding a utility is rows.
///
/// **The storage rule:** a value every scheduler has is a column here; a
/// value only one scheduler needs goes in `settings` and costs no
/// migration. Values belonging to the tenant rather than to a job —
/// timezone, quiet hours, audit retention — stay on `UtilityConfig`.
///
/// `schedulerKey` holds a `SchedulerKey` from
/// `validators/automation-config.ts`. Keys are code, because each names
/// a handler that must exist; values are configuration. A row whose key
/// no build recognises is inert: nothing reads it.
model SchedulerConfig {
  id           String    @id @default(uuid()) @db.Uuid
  utilityId    String    @map("utility_id") @db.Uuid
  utility      Utility   @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  schedulerKey String    @map("scheduler_key") @db.VarChar(50)
  enabled      Boolean   @default(true) @map("enabled")
  /// Null where the job has no time of day — only delinquency and
  /// billing have one.
  runHourLocal Int?      @map("run_hour_local") @db.SmallInt
  /// When the dispatcher last acted for this tenant and this job.
  /// Distinguishes a tick that was missed from one never due.
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz
  settings     Json      @default("{}") @map("settings")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// Two rows for one key would make "is billing enabled" a question
  /// with two answers.
  @@unique([utilityId, schedulerKey])
  @@map("scheduler_config")
}

// Reference table for suspension (hold) types. Replaces the old
// SuspensionType enum. utilityId IS NULL means a system-global code that
// every tenant sees; utilityId set means a tenant-specific code. The
// unique constraint lets both coexist — a tenant can override a global
// label by inserting a row with the same code.
model SuspensionTypeDef {
  id                      String   @id @default(uuid()) @db.Uuid
  utilityId               String?  @map("utility_id") @db.Uuid
  utility     Utility? @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  code                    String   @db.VarChar(50)
  label                   String   @db.VarChar(100)
  description             String?  @db.Text
  category                String?  @db.VarChar(50)
  sortOrder               Int      @default(100) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  defaultBillingSuspended Boolean  @default(true) @map("default_billing_suspended")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, code])
  @@index([isActive, sortOrder])
  @@map("suspension_type_def")
}

model ServiceSuspension {
  id                 String           @id @default(uuid()) @db.Uuid
  utilityId          String           @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  serviceAgreementId String           @map("service_agreement_id") @db.Uuid
  suspensionType     String           @map("suspension_type") @db.VarChar(50)
  status             SuspensionStatus @default(PENDING) @map("status")
  startDate          DateTime         @map("start_date") @db.Date
