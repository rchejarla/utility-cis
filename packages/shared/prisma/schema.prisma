/// Record-only contacts: people on file for an account who do NOT
/// have portal access. Anyone with portal permissions is represented
/// by a CisUser + UserRole(account_id=this account) row instead — the
/// Contacts UI on the account-detail page is a UNION of both sources.
model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  utilityId  String   @map("utility_id") @db.Uuid
