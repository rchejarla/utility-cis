model MeterRegister {
  id             String   @id @default(uuid()) @db.Uuid
  utilityId      String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  meterId        String   @map("meter_id") @db.Uuid
  registerNumber Int      @map("register_number")
  description    String?  @db.VarChar(100)
  uomId          String   @map("uom_id") @db.Uuid
  measureTypeId  String   @map("measure_type_id") @db.Uuid
  multiplier     Decimal  @default(1.0) @db.Decimal(10, 4)
  /// Which TOU period this register counts (spec 26, TOU-REG-1). NULL
  /// for a total register or a non-TOU meter.
  ///
  /// The registers with a code are also the declaration of *which
  /// periods this meter can report*, which is what the bucket loader
  /// uses: a calendar period no register covers gets no bucket, so the
  /// component pricing it raises rather than billing zero for usage the
  /// meter never counted. A partial unique index allows one register
  /// per period per meter — two would be summed and so charged twice.
  ///
  /// Keyed to the tenant's `tou_period` on `(utility_id, peak_code)`
  /// with RESTRICT since 2026-11-06, and left a bare scalar here: this
  /// model's three Prisma relations are all single-column while the
  /// database's are composite, so declaring one accurate relation would
  /// not make the model accurate — it would add a client accessor
  /// nothing asked for and a fourth shape to read past.
  /// `schema-invariants.integration.test.ts` is what pins these keys.
  peakCode       String?  @map("peak_code") @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  meter       Meter          @relation(fields: [meterId], references: [id], onDelete: Cascade)
  uom         UnitOfMeasure  @relation(fields: [uomId], references: [id], onDelete: Restrict)
  measureType MeasureTypeDef @relation(fields: [measureTypeId], references: [id], onDelete: Restrict)
  meterReads  MeterRead[]

  @@unique([meterId, registerNumber])
  @@index([meterId])
  @@index([uomId])
  @@index([measureTypeId])
  @@map("meter_register")
}

model Attachment {
