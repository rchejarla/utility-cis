  @@unique([utilityId, name])
  @@map("role")
}

model CisUser {
  id          String    @id @default(uuid()) @db.Uuid
  /// NULL means "belongs to no tenant", which is the platform actor —
  /// the one identity that sits above tenants (tenancy design note Q2).
  /// Every query reading users by tenant must therefore mean it: a row
  /// that belongs to nobody will not match `utility_id = $1`.
  ///
  /// Both `@@unique` attributes below stop constraining such a row,
  /// because Postgres treats NULLs as distinct. Two partial unique
  /// indexes cover it instead, in
  /// `migrations/20261018160000_platform_actor_identity` — Prisma cannot
  /// express a partial index, so they exist only in SQL.
  utilityId   String?   @map("utility_id") @db.Uuid
  utility     Utility?  @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  externalId  String?   @map("external_id") @db.VarChar(255)
  email       String    @map("email") @db.VarChar(255)
  name        String    @map("name") @db.VarChar(255)
  // Customer link is identity-only ("this user IS this customer person").
  // Permissions live on user_role, not here.
  customerId  String?   @map("customer_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  customer                Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userRoles               UserRole[]
  assignedServiceRequests ServiceRequest[] @relation("ServiceRequestAssignee")
  createdServiceRequests  ServiceRequest[] @relation("ServiceRequestCreator")
  slaEscalations          Sla[]            @relation("SlaEscalationUser")

  @@unique([utilityId, email])
  @@unique([utilityId, externalId])
  @@index([customerId])
  @@index([utilityId, isActive])
  @@map("cis_user")
}

/// Joins users to roles, optionally scoped per account. account_id NULL
/// means the role applies tenant-wide (admin staff). account_id NOT NULL
/// means the role applies only when the user is acting on that account
/// (portal contacts).
///
/// Constraints:
///   - At most one tenant-wide row per user (partial unique index on
///     user_id WHERE account_id IS NULL — Prisma can't express this so
///     it lives in the migration SQL).
///   - At most one role per (user, account) pair — Prisma unique on
///     (userId, accountId) which Postgres treats as distinct when one
///     side is NULL, so it allows the tenant-wide row to coexist with
///     per-account rows. The partial index above closes the only gap.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  utilityId String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  userId    String   @map("user_id") @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    CisUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, accountId])
  @@index([accountId])
  @@index([roleId])
  @@index([utilityId, userId])
  @@map("user_role")
}

model UtilityModule {
  id        String   @id @default(uuid()) @db.Uuid
  utilityId String   @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  moduleKey String   @map("module_key") @db.VarChar(50)
  isEnabled Boolean  @default(true) @map("is_enabled")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz

  @@unique([utilityId, moduleKey])
  @@map("utility_module")
}

// ────────────────────────────────────────────────────────────────────────────
// Phase 2 — Operations entities: meter events, containers, suspensions,
// service events (RAMS), and import batches. Added in the same pass as the
// MeterRead CRUD, solid-waste, transfer-of-service, and move-in/out work.
// ────────────────────────────────────────────────────────────────────────────

enum MeterEventType {
  LEAK
  TAMPER
  REVERSE_FLOW
  HIGH_USAGE
  NO_SIGNAL
  BATTERY_LOW
  COVER_OPEN
  BURST_PIPE
  FREEZE
  OTHER
}

enum MeterEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum MeterEventSource {
  AMI
  FIELD
  MANUAL
  RULE
}

model MeterEvent {
  id              String           @id @default(uuid()) @db.Uuid
  utilityId       String           @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  meterId         String           @map("meter_id") @db.Uuid
  eventType       MeterEventType   @map("event_type")
  status          MeterEventStatus @default(OPEN) @map("status")
  severity        Int              @default(1) @map("severity")
  eventDatetime   DateTime         @map("event_datetime") @db.Timestamptz
