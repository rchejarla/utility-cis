model ImportRow {
  id              String          @id @default(uuid()) @db.Uuid
  /// Denormalised from the batch, because a policy has to read the
  /// tenant off the row. Joining through `import_batch` in a USING
  /// clause would evaluate a subquery per row, and there is one row per
  /// line of an imported CSV.
  utilityId       String          @map("utility_id") @db.Uuid
  utility         Utility         @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  importBatchId   String          @map("import_batch_id") @db.Uuid
