// ─── Delinquency (Module 11) ────────────────────────────────────

enum DelinquencyActionStatus {
  PENDING
  COMPLETED
  RESOLVED
  CANCELLED

  @@map("delinquency_action_status")
}

/// How a tier's late fee is computed. FLAT_FEE reads `feeAmount` as an
/// amount of money; PERCENT_OF_BALANCE reads it as a rate, so 0.0150 is
/// 1.5%, applied to what the account owes in principal.
enum DelinquencyFeeType {
  FLAT_FEE
  PERCENT_OF_BALANCE

  @@map("delinquency_fee_type")
}

/// Whether a tier's fee adds to what the ladder charged below it or
/// replaces it. $10 at 15 days and $25 at 30 days leaves $35 owing under
/// ACCUMULATE and $25 under REPLACE_LOWER_TIERS — the second charge
/// being the penalty for a month, not an addition to the penalty for a
/// fortnight.
enum DelinquencyFeeMode {
  ACCUMULATE
  REPLACE_LOWER_TIERS

  @@map("delinquency_fee_mode")
}

model DelinquencyRule {
  id                    String       @id @default(uuid()) @db.Uuid
  utilityId             String       @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  name                  String       @db.VarChar(255)
  accountType           String?      @map("account_type") @db.VarChar(50)
  commodityId           String?      @map("commodity_id") @db.Uuid
  tier                  Int
  daysPastDue           Int          @map("days_past_due")
  minBalance            Decimal      @map("min_balance") @db.Decimal(10, 2)
  actionType            String       @map("action_type") @db.VarChar(50)
  notificationEventType String?      @map("notification_event_type") @db.VarChar(100)
  autoApply             Boolean      @default(true) @map("auto_apply")
  isActive              Boolean      @default(true) @map("is_active")
  effectiveDate         DateTime     @default(now()) @map("effective_date") @db.Date

  /// What this tier charges, or nothing. The three move together — an
  /// amount with no reason is a charge nobody can explain, a reason with
  /// no amount is dead configuration — which a CHECK enforces.
  ///
  /// `feeReasonId` is configuration rather than something the sweep could
  /// know: reason codes are tenant-configurable, so there is no code this
  /// codebase could hardcode. Its foreign key is
  /// `(utility_id, fee_reason_id) -> ledger_reason_def (utility_id, id)`
  /// and lives in the migration, because Prisma cannot express a
  /// composite relation whose referencing `utility_id` is not optional.
  feeType               DelinquencyFeeType? @map("fee_type")
  /// Decimal(10,4): an amount for FLAT_FEE, a rate for PERCENT_OF_BALANCE.
  feeAmount             Decimal?     @map("fee_amount") @db.Decimal(10, 4)
  /// A ceiling on a percentage fee. Meaningless on a flat one, so a CHECK
  /// refuses the combination.
  maxFee                Decimal?     @map("max_fee") @db.Decimal(10, 2)
  feeReasonId           String?      @map("fee_reason_id") @db.Uuid
  /// Defaults to ACCUMULATE, which is what every tier did before the
  /// mode existed, so configuring a fee changes nobody's bill until
  /// someone asks for replacement. A CHECK refuses
  /// REPLACE_LOWER_TIERS on a tier that charges nothing: that would be
  /// a way to spell forgiveness, and forgiveness is a waiver.
  feeMode               DelinquencyFeeMode @default(ACCUMULATE) @map("fee_mode")

  /// The field work this tier dispatches, by service-request type code,
  /// or null for a tier that dispatches none. Configuration rather than
  /// something inferred from `actionType`, because a utility whose crews
  /// work off their own system wants the notice tiers and no work
  /// orders at all — and because the codes are the tenant's own.
  ///
  /// Validated at save time by `assertServiceRequestTypeCode` rather
  /// than by a foreign key: `service_request_type_def` admits global
  /// rows with a null `utility_id`, which a tenant-scoped composite key
  /// cannot reference.
  serviceRequestTypeCode        String? @map("service_request_type_code") @db.VarChar(100)
  /// And the one raised when the account pays and asks to be turned
  /// back on. It lives beside the shut-off code so the two cannot
  /// disagree about which rung of the ladder they belong to.
  reconnectRequestTypeCode      String? @map("reconnect_request_type_code") @db.VarChar(100)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  commodity Commodity?          @relation(fields: [commodityId], references: [id], onDelete: SetNull)
  actions   DelinquencyAction[]

  @@unique([utilityId, accountType, tier])
  @@index([utilityId, isActive, tier])
  @@map("delinquency_rule")
}

model DelinquencyAction {
  id                  String                  @id @default(uuid()) @db.Uuid
  utilityId           String                  @map("utility_id") @db.Uuid
  utility     Utility @relation(fields: [utilityId], references: [id], onDelete: Restrict)
  accountId           String                  @map("account_id") @db.Uuid
  ruleId              String                  @map("rule_id") @db.Uuid
  tier                Int
  actionType          String                  @map("action_type") @db.VarChar(50)
  status              DelinquencyActionStatus @default(PENDING)
  balanceAtAction     Decimal                 @map("balance_at_action") @db.Decimal(10, 2)
  daysPastDueAtAction Int                     @map("days_past_due_at_action")
  triggeredBy         String                  @map("triggered_by") @db.VarChar(20)
  triggeredByUserId   String?                 @map("triggered_by_user_id") @db.Uuid
  notificationId      String?                 @map("notification_id") @db.Uuid
  /// The fees this action raised, through `delinquency_action_fee`.
  ///
  /// Not a column, because a tier charges **per overdue bill**: one
  /// action can own several fees, one for each bill that has passed the
  /// tier. `fee_entry_id` held exactly one and is dropped.
  ///
  /// A tier that replaces what the ladder charged below it walks these
  /// links to find its candidates, which is what keeps a bounced-payment
  /// fee and an operator's manual late fee out of reach however the
  /// tenant has named its reasons: neither has a delinquency action. The
  /// question is ownership, not category, so it cannot be a filter on
  /// the reason.
  resolvedAt          DateTime?               @map("resolved_at") @db.Timestamptz
  resolutionType      String?                 @map("resolution_type") @db.VarChar(50)
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rule            DelinquencyRule  @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  @@index([accountId, status])
  @@index([utilityId, status, tier])
  @@index([ruleId])
  @@map("delinquency_action")
}

/// Which fees a delinquency action raised.
///
/// A tier charges per overdue bill, so one action owns one fee per bill
/// that had passed it — which is why this is a table and not a column.
/// The bill each fee punishes is on the fee itself, in
/// `ledger_entry.assessed_on_id`, the field slice 3 reserved for exactly
/// this ("a late fee names the debit that went unpaid").
///
/// Keyed on the entry: a fee belongs to one action and no other. Both
/// foreign keys are tenant-scoped composites and live in the migration,
/// because Prisma cannot express a composite relation whose referencing
/// `utility_id` is not optional.
model DelinquencyActionFee {
  utilityId String   @map("utility_id") @db.Uuid
  actionId  String   @map("action_id") @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([utilityId, entryId])
  @@index([utilityId, actionId])
  @@map("delinquency_action_fee")
}

// ─── Payment Plans (Module 10 — collections) ────────────────────

/// What a deferred payment agreement is doing now.
///
/// There is no PENDING. An earlier draft had one for "agreed, down
/// payment not yet received", and the two transitions out of it changed
/// nothing the system did — suppression began at agreement either way.
/// The down payment is the first payment, due on `startDate`.
enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED

  @@map("payment_plan_status")
}

enum PaymentPlanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY

  @@map("payment_plan_frequency")
}

/// An account may pay a named set of overdue debts by instalments, and
/// the delinquency ladder leaves those debts alone while it is kept.
///
/// Nothing here changes a balance. A plan governs *when* money is
/// chased, not *what* is owed: agreeing one posts no ledger entry and
/// moves no debt, which is why every balance query can stay ignorant of
/// plans.
///
/// Both foreign keys to tenant-scoped tables are composite
/// `(utility_id, fk) -> parent (utility_id, id)` and live in
/// `20261028120000_payment_plan/migration.sql`, with the CHECK
/// constraints and the RLS policy — none of which this file can express.
/// `approvedBy` is a single-column key to `cis_user`, whose `utility_id`
/// is nullable. Declaring any of them here would make `migrate diff`
/// propose replacing a composite with a single column; see CLAUDE.md.
model PaymentPlan {
  id        String            @id @default(uuid()) @db.Uuid
  utilityId String            @map("utility_id") @db.Uuid
  accountId String            @map("account_id") @db.Uuid
  status    PaymentPlanStatus

  /// Sum of the covered debits' `openAmount` at creation, frozen. Not
  /// `amount`: a $110.75 charge with $55.37 left owes $55.37.
  totalBalance         Decimal              @map("total_balance") @db.Decimal(14, 2)
  downPayment          Decimal?             @map("down_payment") @db.Decimal(14, 2)
  installmentAmount    Decimal              @map("installment_amount") @db.Decimal(14, 2)
  installmentFrequency PaymentPlanFrequency @map("installment_frequency")
  installmentCount     Int                  @map("installment_count")

  /// The down payment falls due here and instalment *n* on
  /// `startDate + (n - 1) * frequency`. There is no instalment table —
  /// a stored copy of a derivable figure can disagree with the ledger.
  startDate  DateTime @map("start_date") @db.Date
  approvedBy String   @map("approved_by") @db.Uuid
  notes      String?

  /// The six terms this plan is judged by, copied from the tenant's
  /// `paymentPlans` settings when it was agreed. A tenant lowering
  /// grace next month must not break every plan already running.
  graceDays                     Int     @map("grace_days")
  missedBeforeDefault           Int     @map("missed_before_default")
  partialInstallmentCounts      Boolean @map("partial_installment_counts")
  currentBillCounts             Boolean @map("current_bill_counts")
  suppressFeesWhileKept         Boolean @map("suppress_fees_while_kept")
  assessSuppressedFeesOnDefault Boolean @map("assess_suppressed_fees_on_default")

  /// The highest instalment already noticed as late — 0 for the down
  /// payment, n for instalment n. The sweep runs nightly, so a notice
  /// keyed on "is late" alone would mail the customer every night.
  lateNoticeInstallment Int? @map("late_notice_installment")

  /// When the status last moved. `updatedAt` cannot answer "defaulted
  /// when?" — editing a note in March would relabel a December default.
  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([utilityId, id])
  @@index([utilityId, accountId])
  @@index([utilityId, status])
  @@map("payment_plan")
}

/// Which debts a plan covers.
///
/// These rows persist after the plan ends — they are history, and every
/// key is RESTRICT — which is why suppression must join through to
/// `PaymentPlan.status` and never test membership here: a membership
/// test would suppress a debit forever, including after default, and
/// would pass every test written while the plan was still running.
///
/// Keyed per plan, so a debit may appear in more than one plan over
/// time. "Not in two **live** plans at once" is the invariant that
/// actually matters, and no index can express it — the predicate lives
/// on `PaymentPlan.status`, in another table. `createPaymentPlan`
/// enforces it, and the one-ACTIVE-plan-per-account rule makes it
/// structural: a debit must be on the plan's own account, and an account
/// may have one live plan.
model PaymentPlanDebit {
  utilityId String   @map("utility_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([utilityId, planId, entryId])
  @@index([utilityId, entryId])
  @@map("payment_plan_debit")
}

